 you can apply ","type":"text"},{"code":"@LazyField","type":"codeVoice"},{"text":" to it. LazyFields are always optional.","type":"text"}]}],"media":null,"caption":[],"code":"quickstart-model-3.swift","type":"step"},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Last, add an initializer you want to use to create a new instance of your model."}]}],"media":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"For easier access to it you can create a typealias outside of the ","type":"text"},{"code":"VersionedSchema","type":"codeVoice"},{"text":".","type":"text"}]}],"code":"quickstart-model-4.swift","type":"step"},{"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Vein requires a "},{"type":"codeVoice","code":"SchemaMigrationPlan"},{"type":"text","text":", but don’t worry, you don’t have to migrate anything right now."}],"type":"paragraph"}],"media":null,"caption":[{"inlineContent":[{"type":"text","text":"Just add your VersionedSchema to the schemas array."}],"type":"paragraph"}],"code":"quickstart-model-5.swift","type":"step"}],"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"Now, let’s build your data model using VeinCore."}],"type":"paragraph"}]}],"anchor":"Create-your-first-Model"},{"title":"ModelContainer & ManagedObjectContext","stepsSection":[{"media":null,"code":"quickstart-use-1.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First you need to create a model container."},{"type":"text","text":" "},{"type":"text","text":"Vein encrypts on the DB level by default."},{"type":"text","text":" "},{"type":"text","text":"If you don’t want that, you can disable it via the encryptionEnabled parameter."}]}],"caption":[],"type":"step","runtimePreview":null},{"media":null,"code":"quickstart-use-2.swift","content":[{"inlineContent":[{"text":"Tell the container to migrate to the current schema if