entifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","","    try container.migrate()","","    let post = Post(title: \"How to use Vein?\", content: \"It's very easy.\")","    try container.context.insert(post)","}"],"identifier":"quickstart-use-3.swift","highlights":[],"fileType":"swift","fileName":"VeinExample.swift","syntax":"swift"},"quickstart-model-0.swift":{"identifier":"quickstart-model-0.swift","content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","","    ]","}"],"fileName":"Post.swift","type":"file","syntax":"swift","fileType":"swift","highlights":[]},"quickstart-model-2.swift":{"type":"file","content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self","    ]","","    @Model","    final class Post {","        var title: String","        var content: String","    }","}"],"identifier":"quickstart-model-2.swift","highlights":[],"fileType":"swift","fileName":"Post.swift","syntax":"swift"},"quickstart-use-1.swift":{"identifier":"quickstart-use-1.swift","content":["import VeinCore","","func setupAndUseVein() throws {","    \/\/ When encryption is enabled and you're running on Linux,","    \/\/ you need to tell KeyringAccess your appID too.","    \/\/ If Linux is not one of your targets you can ignore it.","    #if os(Linux)","        Keyring.appIdentifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","}"],"fileName":"VeinExample.swift","type":"file","syntax":"swift","fileType":"swift","highlights":[]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Create-your-first-Model":{"kind":"section","type":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Create-your-first-Model","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-swift-package#Create-your-first-Model","title":"Create your first Model"},"quickstart-use-4.swift":{"type":"file","content":["import VeinCore","","func setupAndUseVein() throws {","    \/\/ When encryption is enabled and you're running on Linux,","    \/\/ you need to tell KeyringAccess your appID too.","    \/\/ If Linux is not one of your targets you can ignore it.","    #if os(Linux)","        Keyring.appIdentifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","","    try container.migrate()","","    let post = Post(title: \"How to use Vein?\", content: \"It's very easy.\")","    try container.context.insert(post)","","    post.content = \"What did I tell you?\"","}"],"identifier":"quickstart-use-4.swift","highlights":[],"fileName":"VeinExample.swift","fileType":"swift","syntax":"swift"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","title":"Custom Persistable","url":"\/tutorials\/veincore\/custompersistable","type":"topic","kind":"project","estimatedTime":"5min","abstract":[{"text":"Make your own types persistable.","type":"text"}],"role":"project"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"kind":"section","type":"section","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","role":"pseudoSymbol","url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","title":"Adding a relationship to our model"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","title":"Complex Migrations","url":"\/tutorials\/veincore\/complexmigrations","type":"topic","kind":"project","estimatedTime":"7min","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"role":"project"},"doc://VeinCore/tutorials/VeinCore/Relationships#Persisting--fetching-a-relationship":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Persisting--fetching-a-relationship","title":"Persisting & fetching a relationship","url":"\/tutorials\/veincore\/relationships#Persisting--fetching-a-relationship","type":"section","kind":"section","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/Table-of-Contents":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","title":"Meet Vein","url":"\/tutorials\/table-of-contents","type":"topic","kind":"overview","abstract":[{"text":"Database for apps made easy.","type":"text"}],"role":"overview"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"kind":"section","type":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","title":"Create your first Model"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#The-migration-we-are-going-to-test":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","title":"The migration we are going to test:","url":"\/tutorials\/veincore\/migrationunittests#The-migration-we-are-going-to-test","type":"section","kind":"section","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","title":"Unit Testing","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing","type":"section","kind":"section","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"role":"pseudoSymbol"},"quickstart-use-6.swift":{"identifier":"quickstart-use-6.swift","content":["import VeinCore","","func setupAndUseVein() throws {","    \/\/ When encryption is enabled and you're running on Linux,","    \/\/ you need to tell KeyringAccess your appID too.","    \/\/ If Linux is not one of your targets you can ignore it.","    #if os(Linux)","        Keyring.appIdentifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","","    try container.migrate()","","    let post = Post(title: \"How to use Vein?\", content: \"It's very easy.\")","    try container.context.insert(post)","","    post.content = \"What did I tell you?\"","","    try container.context.save()","","    let posts = try container.context.fetchAll(#Predicate<Post> { post in","        post.title.contains(\"Vein\")","    }) \/\/ gives back [post]","}"],"fileName":"VeinExample.swift","type":"file","syntax":"swift","fileType":"swift","highlights":[]},"quickstart-use-2.swift":{"type":"file","content":["import VeinCore","","func setupAndUseVein() throws {","    \/\/ When encryption is enabled and you're running on Linux,","    \/\/ you need to tell KeyringAccess your appID too.","    \/\/ If Linux is not one of your targets you can ignore it.","    #if os(Linux)","        Keyring.appIdentifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","","    try container.migrate()","}"],"identifier":"quickstart-use-2.swift","highlights":[],"fileName":"VeinExample.swift","fileType":"swift","syntax":"swift"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor":{"kind":"section","type":"section","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor","role":"pseudoSymbo