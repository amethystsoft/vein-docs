eContent":[{"text":"If you don’t want data to be loaded on fetch, but only when its needed, which can make sense for larger data, you can apply ","type":"text"},{"code":"@LazyField","type":"codeVoice"},{"text":" to it. LazyFields are always optional.","type":"text"}]}],"caption":[],"media":null},{"type":"step","runtimePreview":null,"code":"quickstart-model-4.swift","content":[{"inlineContent":[{"text":"Last, add an initializer you want to use to create a new instance of your model.","type":"text"}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"For easier access to it you can create a typealias outside of the "},{"code":"VersionedSchema","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"media":null},{"type":"step","runtimePreview":null,"code":"quickstart-model-5.swift","content":[{"inlineContent":[{"text":"Vein requires a ","type":"text"},{"code":"SchemaMigrationPlan","type":"codeVoice"},{"text":", but don’t worry, you don’t have to migrate anything right now.","type":"text"}],"type":"paragraph"}],"caption":[{"inlineContent":[{"text":"Just add your VersionedSchema to the schemas array.","type":"text"}],"type":"paragraph"}],"media":null}],"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now, let’s build your data model using VeinCore."}]}]}]},{"anchor":"ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext","stepsSection":[{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"First you need to create a model container.","type":"text"},{"text":" ","type":"text"},{"text":"Vein encrypts on the DB level by default.","type":"text"},{"text":" ","type":"text"},{"text":"If you don’t want that, you can disable it via the encryptionEnabled parameter.","type":"text"}]}],"media":null,"type":"step","caption":[],"code":"quickstart-use-1.swift"},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Tell the container to migrate to the current schema if needed.","type":"text"}]}],"media":null,"type":"step","caption":[],"code":"quickstart-use-2.swift"},{"runtimePreview":null,"content":[{"inlineContent":[{"text":"Create a post and add it to the context.","type":"text"}],"type":"paragraph"}],"media":null,"type":"step","caption":[],"code":"quickstart-use-3.swift"},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To update a field, just set it to something new via the swift property."}]}],"media":null,"type":"step","caption":[],"code":"quickstart-use-4.swift"},{"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"To persist changes, you need to call "},{"code":"save()","type":"codeVoice"},{"type":"text","text":" on the context."}],"type":"paragraph"}],"media":null,"type":"step","caption":[{"inlineContent":[{"type":"text","text":"Until then all changes are only tracked in memory."}],"type":"paragraph"}],"code":"quickstart-use-5.swift"},{"runtimePreview":null,"content":[{"inlineContent":[{"text":"To retrieve models from the context, persisted and unpersisted, you can use fetchAll on the context and filter using a Predicate.","type":"text"}],"type":"paragraph"}],"media":null,"type":"step","caption":[],"code":"quickstart-use-6.swift"},{"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Last but not least, to delete a model, just call "},{"type":"codeVoice","code":"context.delete()"},{"type":"text","text":" with it."}],"type":"paragraph"}],"media":null,"type":"step","caption":[],"code":"quickstart-use-7.swift"}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"How to use the Model?","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}]}]},{"kind":"callToAction","title":"Quick start Xcode","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"action":{"isActive":true,"identi