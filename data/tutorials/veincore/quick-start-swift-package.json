ainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","","    try container.migrate()","}"],"highlights":[],"fileName":"VeinExample.swift","identifier":"quickstart-use-2.swift"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#The-migration-we-are-going-to-test":{"type":"section","title":"The migration we are going to test:","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","url":"\/tutorials\/veincore\/migrationunittests#The-migration-we-are-going-to-test","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Manual-Persistable":{"abstract":[{"text":"Make your own types persistable.","type":"text"}],"kind":"section","title":"Manual Persistable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable","url":"\/tutorials\/veincore\/custompersistable#Manual-Persistable","type":"section","role":"pseudoSymbol"},"quickstart-use-7.swift":{"highlights":[],"fileName":"VeinExample.swift","syntax":"swift","fileType":"swift","type":"file","content":["import VeinCore","","func setupAndUseVein() throws {","    \/\/ When encryption is enabled and you're running on Linux,","    \/\/ you need to tell KeyringAccess your appID too.","    \/\/ If Linux is not one of your targets you can ignore it.","    #if os(Linux)","        Keyring.appIdentifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your Ve