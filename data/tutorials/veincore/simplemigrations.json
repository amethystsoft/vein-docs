 Testing Migrations","url":"\/tutorials\/table-of-contents\/unit-testing-migrations","abstract":[],"type":"topic"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"title":"Writing Custom Migration Logic","type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"title":"Adding a relationship to our model","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","kind":"section","url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","type":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"role":"pseudoSymbol","type":"section","title":"Setup","url":"\/tutorials\/veincore\/quick-start-xcode#Setup","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","kind":"section"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"kind":"article","abstract":[],"url":"\/tutorials\/table-of-contents\/relationships","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","role":"article","title":"Relationships","type":"topic"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","abstract":[{"text":"Make your own types persistable.","type":"text"}],"url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","role":"pseudoSymbol","title":"RawRepresentable"},"doc://VeinCore/tutorials/VeinCore/Relationships":{"title":"Relationships","role":"project","kind":"project","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"url":"\/tutorials\/veincore\/relationships","estimatedTime":"3min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships","type":"topic"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"title":"Custom Persistable","kind":"project","type":"topic","url":"\/tutorials\/veincore\/custompersistable","abstract":[{"text":"Make your own types persistable.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","estimatedTime":"5min","role":"project"},"migration-stages-2.swift":{"syntax":"swift","identifier":"migration-stages-2.swift","content":["import VeinCore","","enum Migration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ 1. Unchanged models must still be carried over","            try V0_0_1.Post.unchangedMigration(","                to: V0_0_2.Post.self,","                on: context","            )","","            \/\/ 2. Safely introduce the newly added optional fields","            try V0_0_1.Attachment.fieldsAddedMigration(","                to: V0_0_2.Attachment.self,","                on: context","            )","","            \/\/ 3. Drop tables\/data you no longer require","            try V0_0_1.Unused.deleteMigration(on: context)","        },","        didMigrate: nil","    )","}"],"fileType":"swift","fileName":"Migration.swift","type":"file","highlights":[]},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable"