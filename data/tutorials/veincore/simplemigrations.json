ions"},{"tasks":[{"anchor":"Migrating-Schemas","title":"Migrating Schemas","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"As your app grows, you will inevitably need to change your data models."},{"type":"text","text":" "},{"type":"text","text":"Vein handles this through explicit, compile-time typesafe migrations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this guide, we will migrate from V0_0_1 to V0_0_2. During this change:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Post"},{"type":"text","text":" remains unchanged."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Attachment"},{"type":"text","text":" receives a new optional "},{"type":"codeVoice","code":"rating"},{"type":"text","text":" field."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A legacy class "},{"code":"Unused","type":"codeVoice"},{"type":"text","text":" is completely deleted."}]}]}]}]}],"stepsSection":[{"type":"step","code":"migration-schemas.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Define your next schema version. In ","type":"text"},{"code":"V0_0_2","type":"codeVoice"},{"text":", we declare our updated models.","type":"text"},{"text":" ","type":"text"},{"text":"Note that the new property ","type":"text"},{"code":"rating","type":"codeVoice"},{"text":" must be an optional value.","type":"text"}]}],"runtimePreview":null,"caption":[]},{"type":"step","code":"migration-stages-1.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now, create your "},{"type":"codeVoice","code":"SchemaMigrationPlan"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You list your supported schemas in chronological order and define the transitions in the "},{"type":"codeVoice","code":"stages"},{"type":"text","text":" array."}]}],"runtimePreview":null,"caption":[]},{"type":"step","code":"migration-stages-2.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside the "},{"type":"codeVoice","code":"willMigrate"},{"type":"text","text":" phase, utilize Vein’s migration helpers."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"unchangedMigration"},{"type":"text","text":" to keep a table intact, "},{"type":"codeVoice","code":"deleteMigration"},{"type":"text","text":" to drop a table, and "},{"type":"codeVoice","code":"fieldsAddedMigration"},{"type":"text","text":" to safely append the new optional column."}]}],"runtimePreview":null,"caption":[]}]}],"kind":"tasks"},{"featuredEyebrow":"Tutorial","action":{"type":"reference","overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","isActive":true},"title":"Complex Migrations","kind":"callToAction","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}]}],"metadata":{"category":"Vein","role":"project","title":"Simple Database Migrations","categoryPathComponent":"Table-of-Contents"},"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/veincore\/simplemigrations"]}],"references":{"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package":{"kind":"project","type":"topic","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package","role":"project","url":"\/tutorials\/veincore\/quick-start-swift-package","estimatedTime":"5min","title":"Quick start Swift Package"},"doc://VeinCore/tutorials/Table-of-Contents":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","title":"Meet Vein","url":"\/tutorials\/table-of-contents","type":"topic","kind":"overview","abstract":[{"text":"Database for apps made easy.","type":"text"}],"role":"overview"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","title":"Quick start","url":"\/tutorials\/table-of-contents\/quick-start","type":"topic","kind":"article","abstract":[],"role":"article"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing-full-migration-chain":{"url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing-full-migration-chain","type":"section","role":"pseudoSymbol","title":"Unit Testing full migration chain","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Codable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Codable","title":"Codable","url":"\/tutorials\/veincore\/custompersistable#Codable","type":"section","kind":"section","abstract":[{"text":"Make your own types persistable.","type":"text"}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"kind":"section","type":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","title":"Create your first Model"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","role":"article","url":"\/tutorials\/table-of-contents\/simple-migrations","title":"Simple Migrations"},"doc://VeinCore/tutorials/Table-of-Contents/Complex-Migrations":{"type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations","role":"article","url":"\/tutorials\/table-of-contents\/complex-migrations","title":"Complex Migrations"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","title":"Migrating Schemas","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","type":"section","kind":"section","abstract":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}],"role":"pseudoSymbol"},"migration-schemas.swift":{"content":["import VeinCore","","\/\/ Our baseline schema","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self,","        Unused.self","    ]","","    @Model final class Post { var title: String \/* ... *\/ }","    @Model final class Attachment { var name: String \/* ... *\/ }","    @Model final class Unused { var content: String \/* ... *\/ }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self","    ]","","    @Model final class Post { var title: String }","","    @Model final class Attachment {","        var name: String","","        \/\/ New optional field allows safe column additions","        var rating: Int?","    }","}"],"type":"file","identifier":"migration-schemas.swift","highlights":[],"fileType":"swift","fileName":"Schemas.swift","syntax":"swift"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","title":"Complex Migrations","url":"\/tutorials\/veincore\/complexmigrations","type":"topic","kind":"project","estimatedTime":"7min","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"role":"project"},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","role":"article","url":"\/tutorials\/table-of-contents\/unit-testing-migrations","title":"Unit Testing Migrations"},"doc://VeinCore/tutorials/VeinCore/Relationships":{"estimatedTime":"3min","url":"\/tutorials\/veincore\/relationships","type":"topic","role":"project","kind":"project","title":"Relationships","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries":{"estimatedTime":"5min","url":"\/tutorials\/veincore\/advancedqueries","type":"topic","role":"project","kind":"project","title":"Advanced Queries","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"kind":"section","type":"section","abstract":[{"text":"Make your own types persistable.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","role":"pseudoSymbol","url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","title":"RawRepresentable"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations":{"estimatedTime":"5min","url":"\/tutorials\/veincore\/simplemigrations","type":"topic","role":"project","kind":"project","title":"Simple Database Migrations","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations","abstract":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode":{"estimatedTime":"5min","url":"\/tutorials\/veincore\/quick-start-xcode","type":"topic","role":"project","kind":"project","title":"Quick start Xcode","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","type":"section","kind":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"role":"pseudoSymbol"},"migration-stages-2.swift":{"identifier":"migration-stages-2.swift","content":["import VeinCore","","enum Migration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ 1. Unchanged models must still be carried over","            try V0_0_1.Post.unchangedMigration(","                to: V0_0_2.Post.self,","                on: context","            )","","            \/\/ 2. Safely introduce the newly added optional fields","            try V0_0_1.Attachment.fieldsAddedMigration(","                to: V0_0_2.Attachment.self,","                on: context","            )","","            \/\/ 3. Drop tables\/data you no longer require","            try V0_0_1.Unused.deleteMigration(on: context)","        },","        didMigrate: nil","    )","}"],"fileName":"Migration.swift","type":"file","syntax":"swift","fileType":"swift","highlights":[]},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable","role":"article","url":"\/tutorials\/table-of-contents\/custom-persistable","title":"Custom Persistable"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","title":"Unit Testing","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing","type":"section","kind":"section","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor":{"kind":"section","type":"section","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor","role":"pseudoSymbol","url":"\/tutorials\/veincore\/advancedqueries#FetchDescriptor-and-PaginatedFetchDescriptor","title":"FetchDescriptor and PaginatedFetchDescriptor"},"doc://VeinCore/tutorials/Table-of-Contents/Advanced-Queries":{"kind":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Advanced-Queries","role":"article","url":"\/tutorials\/table-of-contents\/advanced-queries","title":"Advanced Queries"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--Managed