{"sections":[{"estimatedTimeInMinutes":5,"chapter":"Simple Migrations","content":[{"type":"paragraph","inlineContent":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}]}],"kind":"hero","title":"Simple Database Migrations"},{"kind":"tasks","tasks":[{"title":"Migrating Schemas","anchor":"Migrating-Schemas","stepsSection":[{"runtimePreview":null,"code":"migration-schemas.swift","type":"step","content":[{"inlineContent":[{"type":"text","text":"Define your next schema version. In "},{"type":"codeVoice","code":"V0_0_2"},{"type":"text","text":", we declare our updated models."},{"type":"text","text":" "},{"type":"text","text":"Note that the new property "},{"type":"codeVoice","code":"rating"},{"type":"text","text":" must be an optional value."}],"type":"paragraph"}],"caption":[],"media":null},{"runtimePreview":null,"code":"migration-stages-1.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now, create your "},{"type":"codeVoice","code":"SchemaMigrationPlan"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You list your supported schemas in chronological order and define the transitions in the "},{"type":"codeVoice","code":"stages"},{"type":"text","text":" array."}]}],"caption":[],"media":null},{"runtimePreview":null,"code":"migration-stages-2.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Inside the ","type":"text"},{"type":"codeVoice","code":"willMigrate"},{"text":" phase, utilize Vein’s migration helpers.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"type":"codeVoice","code":"unchangedMigration"},{"text":" to keep a table intact, ","type":"text"},{"type":"codeVoice","code":"deleteMigration"},{"text":" to drop a table, and ","type":"text"},{"type":"codeVoice","code":"fieldsAddedMigration"},{"text":" to safely append the new optional column.","type":"text"}]}],"caption":[],"media":null}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"As your app grows, you will inevitably need to change your data models."},{"type":"text","text":" "},{"type":"text","text":"Vein handles this through explicit, compile-time typesafe migrations."}]},{"type":"paragraph","inlineContent":[{"text":"In this guide, we will migrate from V0_0_1 to V0_0_2. During this change:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Post"},{"type":"text","text":" remains unchanged."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Attachment"},{"type":"text","text":" receives a new optional "},{"type":"codeVoice","code":"rating"},{"type":"text","text":" field."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A legacy class ","type":"text"},{"code":"Unused","type":"codeVoice"},{"text":" is completely deleted.","type":"text"}]}]}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}]}]},{"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Complex Migrations","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"action":{"overridingTitle":"Get started","isActive":true,"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference"}}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"project","identifier":{"url":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/VeinCore\/tutorials\/Table-of-Contents","doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/$volume","doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations"]],"reference":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","modules":[{"projects":[{"reference":"doc:\/\/VeinCore\/t