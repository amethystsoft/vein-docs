re and create your first model."}],"kind":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package","url":"\/tutorials\/veincore\/quick-start-swift-package","title":"Quick start Swift Package","estimatedTime":"5min"},"doc://VeinCore/tutorials/VeinCore/Relationships#Persisting--fetching-a-relationship":{"kind":"section","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Persisting--fetching-a-relationship","title":"Persisting & fetching a relationship","type":"section","url":"\/tutorials\/veincore\/relationships#Persisting--fetching-a-relationship","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations":{"role":"project","abstract":[{"type":"text","text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions."}],"title":"Simple Database Migrations","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations","type":"topic","kind":"project","estimatedTime":"5min","url":"\/tutorials\/veincore\/simplemigrations"},"doc://VeinCore/tutorials/Table-of-Contents":{"type":"topic","url":"\/tutorials\/table-of-contents","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","title":"Meet Vein","kind":"overview","abstract":[{"type":"text","text":"Database for apps made easy."}],"role":"overview"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Create-your-first-Model":{"title":"Create your first Model","kind":"section","url":"\/tutorials\/veincore\/quick-start-swift-package#Create-your-first-Model","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Create-your-first-Model","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"role":"pseudoSymbol","type":"section"},"migration-schemas.swift":{"highlights":[],"syntax":"swift","content":["import VeinCore","","\/\/ Our baseline schema","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self,","        Unused.self","    ]","","    @Model final class Post { var title: String \/* ... *\/ }","    @Model final class Attachment { var name: String \/* ... *\/ }","    @Model final class Unused { var content: String \/* ... *\/ }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self","    ]","","    @Model final class Post { var title: String }","","    @Model final class Attachment {","        var name: String","","        \/\/ New optional field allows safe column additions","        var rating: Int?","    }","}"],"identifier":"migration-schemas.swift","fileType":"swift","type":"file","fileName":"Schemas.swift"},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"title":"Unit Testing Migrations","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","role":"article","kind":"article","url":"\/tutorials\/table-of-contents\/unit-testing-migrations","type":"topic"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing-full-migration-chain":{"title":"Unit Testing full migration chain","role":"pseudoSymbol","kind":"section","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing-full-migration-chain","type":"section"}}}