ment { var name: String \/* ... *\/ }","    @Model final class Unused { var content: String \/* ... *\/ }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self","    ]","","    @Model final class Post { var title: String }","","    @Model final class Attachment {","        var name: String","","        \/\/ New optional field allows safe column additions","        var rating: Int?","    }","}"],"fileType":"swift"},"doc://VeinCore/tutorials/Table-of-Contents/Advanced-Queries":{"title":"Advanced Queries","url":"\/tutorials\/table-of-contents\/advanced-queries","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Advanced-Queries","kind":"article"},"doc://VeinCore/tutorials/Table-of-Contents/Complex-Migrations":{"type":"topic","role":"article","url":"\/tutorials\/table-of-contents\/complex-migrations","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations","title":"Complex Migrations","abstract":[],"kind":"article"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"url":"\/tutorials\/veincore\/quick-start-xcode#Setup","kind":"section","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","type":"section","title":"Setup","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","title":"Unit Testing","role":"pseudoSymbol","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing","kind":"section"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries":{"title":"Advanced Queries","url":"\/tutorials\/veincore\/advancedqueries","estimatedTime":"5min","role":"project","type":"topic","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries","kind":"project"},"doc://VeinCore/tutorials/VeinCore/Relationships":{"kind":"project","url":"\/tutorials\/veincore\/relationships","type":"topic","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"estimatedTime":"3min","role":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships","title":"Relationships"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"url":"\/tutorials\/veincore\/migrationunittests","role":"project","type":"topic","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"title":"Unit Testing Migrations","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"kind":"article","title":"Simple Migrations","role":"article","url":"\/tutorials\/table-of-contents\/simple-migrations","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","abstract":[]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Create-your-first-Model":{"type":"section","kind":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"title":"Create your first Model","url":"\/tutorials\/veincore\/quick-start-swift-package#Create-your-first-Model","role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-