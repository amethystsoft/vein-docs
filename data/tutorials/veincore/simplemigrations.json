-Package#ModelContainer--ManagedObjectContext","url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext","role":"pseudoSymbol","title":"ModelContainer & ManagedObjectContext","kind":"section","type":"section"},"migration-stages-1.swift":{"type":"file","content":["import VeinCore","","enum Migration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [","            V0_0_1.self,","            V0_0_2.self","        ]","    }","","    static var stages: [MigrationStage] {","        [","            migrateV1toV2","        ]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ Migration helpers will go here...","        },","        didMigrate: nil","    )","}"],"identifier":"migration-stages-1.swift","fileType":"swift","highlights":[],"syntax":"swift","fileName":"Migration.swift"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"url":"\/tutorials\/table-of-contents\/quick-start","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","title":"Quick start","kind":"article","type":"topic","abstract":[]},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"title":"Relationships","type":"topic","kind":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","url":"\/tutorials\/table-of-contents\/relationships","abstract":[],"role":"article"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries":{"role":"project","title":"Advanced Queries","url":"\/tutorials\/veincore\/advancedqueries","kind":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"estimatedTime":"5min","type":"topic"},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"abstract":[],"type":"topic","url":"\/tutorials\/table-of-contents\/custom-persistable","kind":"article","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable","title":"Custom Persistable"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Codable":{"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Codable","type":"section","url":"\/tutorials\/veincore\/custompersistable#Codable","role":"pseudoSymbol","title":"Codable","abstract":[{"text":"Make your own types persistable.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"type":"section","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"kind":"section","title":"ModelContainer & ManagedObjectContext","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","role":"pseudoSymbol","type":"section","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"title":"Unit Testing","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing","kind":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Create-your-first-Model":{"type":"section","url":"\/tutorials\/veincore\/quick-start-swift-package#Create-your-first-Model","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Create-your-first-Model","title":"Create your first Model","role":"pseudoSymbol","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}]},"doc://VeinCore/tutorials/Table-of-Contents/Advanced-Queries":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Advanced-Queries","url":"\/tutorials\/table-of-contents\/advanced-queries","role":"article","type":"topic","abstract":[],"kind":"article","title":"Advanced Queries"},"doc://VeinCore/tutorials/Table-of-Contents":{"kind":"overview","title":"Meet Vein","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","type":"topic","url":"\/tutorials\/table-of-contents","abstract":[{"text":"Database for apps made easy.","type":"text"}],"role":"overview"},"migration-stages-2.swift":{"content":["import VeinCore","","enum Migration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ 1. Unchanged models must still be carried over","            try V0_0_1.Post.unchangedMigration(","                to: V0_0_2.Post.self,","                on: context","            )","","            \/\/ 2. Safely introduce the newly added optional fields","            try V0_0_1.Attachment.fieldsAddedMigration(","                to: V0_0_2.Attachment.self,","                on: context","            )","","            \/\/ 3. Drop tables\/data you no longer require","            try V0_0_1.Unused.deleteMigration(on: context)","        },","        didMigrate: nil","    )","}"],"type":"file","identifier":"migration-stages-2.swift","fileType":"swift","syntax":"swift","highlights":[],"fileName":"Migration.swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode":{"kind":"project","role":"project","type":"topic","url":"\/tutorials\/veincore\/quick-start-xcode","title":"Quick start Xcode","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"estimatedTime":"5min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode"},"migration-schemas.swift":{"content":["import VeinCore","","\/\/ Our baseline schema","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self,","        Unused.self","    ]","","    @Model final class Post { var title: String \/* ... *\/ }","    @Model final class Attachment { var name: String \/* ... *\/ }","    @Model final class Unused { var content: String \/* ... *\/ }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self","    ]","","    @Model final class Post { var title: String }","","    @Model final class Attachment {","        var name: String","","        \/\/ New optional field allows safe column additions","        var rating: Int?","    }","}"],"fileType":"swift","type":"file","syntax":"swift","highlights":[],"identifier":"migration-schemas.swift","fileName":"Schemas.swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","title":"Setup","url":"\/tutorials\/veincore\/quick-start-xcode#Setup","role":"pseudoSymbol","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"type":"section","kind":"section"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"abstract":[],"type":"topic","url":"\/tutorials\/table-of-contents\/simple-migrations","kind":"article","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","title":"Simple Migrations"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"title":"Complex Migrations","ty