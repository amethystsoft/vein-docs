Voice"},{"text":" to keep a table intact, ","type":"text"},{"code":"deleteMigration","type":"codeVoice"},{"text":" to drop a table, and ","type":"text"},{"code":"fieldsAddedMigration","type":"codeVoice"},{"text":" to safely append the new optional column.","type":"text"}],"type":"paragraph"}]}],"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"As your app grows, you will inevitably need to change your data models.","type":"text"},{"text":" ","type":"text"},{"text":"Vein handles this through explicit, compile-time typesafe migrations.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this guide, we will migrate from V0_0_1 to V0_0_2. During this change:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Post","type":"codeVoice"},{"type":"text","text":" remains unchanged."}]}]},{"content":[{"inlineContent":[{"code":"Attachment","type":"codeVoice"},{"text":" receives a new optional ","type":"text"},{"code":"rating","type":"codeVoice"},{"text":" field.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A legacy class "},{"type":"codeVoice","code":"Unused"},{"type":"text","text":" is completely deleted."}]}]}]}]}]}],"kind":"tasks"},{"title":"Complex Migrations","featuredEyebrow":"Tutorial","action":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference","isActive":true,"overridingTitle":"Get started"},"kind":"callToAction","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}]}],"hierarchy":{"modules":[{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup"},{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials