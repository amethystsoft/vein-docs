,"sections":[{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic"}]}],"reference":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations"},{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable"},{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Codable"},{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable"}],"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable"}],"reference":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable"},{"projects":[{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests","sections":[{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","kind":"task"},{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","kind":"task"},{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain","kind":"task"}]}],"reference":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations"}]},"kind":"project","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations"},"metadata":{"role":"project","title":"Simple Database Migrations","category":"Vein","categoryPathComponent":"Table-of-Contents"},"variants":[{"paths":["\/tutorials\/veincore\/simplemigrations"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[{"chapter":"Simple Migrations","title":"Simple Database Migrations","estimatedTimeInMinutes":5,"kind":"hero","content":[{"inlineContent":[{"type":"text","text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions."}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"stepsSection":[{"type":"step","content":[{"inlineContent":[{"text":"Define your next schema version. In ","type":"text"},{"type":"codeVoice","code":"V0_0_2"},{"text":", we declare our updated models.","type":"text"},{"text":" ","type":"text"},{"text":"Note that the new property ","type":"text"},{"type":"codeVoice","code":"rating"},{"type":"text","text":" must be an optional value."}],"type":"paragraph"}],"code":"migration-schemas.swift","runtimePreview":null,"media":null,"caption":[]},{"runtimePreview":null,"media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Now, create your ","type":"text"},{"code":"SchemaMigrationPlan","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"You list your supported schemas in chronological order and define the transitions in the ","type":"text"},{"code":"stages","type":"codeVoice"},{"text":" array.","type":"text"}]}],"code":"migration-stages-1.swift","type":"step","caption":[]},{"runtimePreview":null,"media":null,"content":[{"inlineContent":[{"text":"Inside the ","type":"text"},{"code":"willMigrate","type":"codeVoice"},{"text":" phase, utilize Vein’s migration helpers.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"unchangedMigration","type":"codeVoice"},{"text":" to keep a table intact, ","type":"text"},{"code":"deleteMigration","type":"codeVoice"},{"text":" to drop a table, and ","type":"text"},{"code":"fieldsAddedMigration","type":"codeVoice"},{"text":" to safely append the new optional column.","type":"text"}],"type":"paragraph"}],"code":"migration-stages-2.swift","type":"step","caption":[]}],"contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"As your app grows, you will inevitably need to change your data models."},{"type":"text","text":" "},{"type":"text","text":"Vein handles this through explicit, compile-time typesafe migrations."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In this guide, we will migrate from V0_0_1 to V0_0_2. During this change:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"Post","type":"codeVoice"},{"type":"text","text":" remains unchanged."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Attachment","type":"codeVoice"},{"text":" receives a new optional ","type":"text"},{"code":"rating","type":"codeVoice"},{"text":" field.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A legacy class "},{"type":"codeVoice","code":"Unused"},{"type":"text","text":" is completely deleted."}],"type":"paragraph"}]}]}],"mediaPosition":"trailing"}],"anchor":"Migrating-Schemas","title":"Migrating Schemas"}]},{"abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"featuredEyebrow":"Tutorial","title":"Complex Migrations","action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","isActive":true,"overridingTitle":"Get started","type":"reference"},"kind":"callToAction"}],"references":{"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"kind":"section","type":"section","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"title":"Writing Custom Migration Logic","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"title":"Unit Testing Migrations","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"kind":"project","role":"project","url":"\/tutorials\/veincore\/migrationunittests","estimatedTime":"10min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests","type":"topic"},"doc://VeinCore/tutorials/VeinCore/Relationships#Persisting--fetching-a-relationship":{"title":"Persisting & fetching a relationship","url":"\/tutorials\/veincore\/relationships#Persisting--fetching-a-relationship","role":"pseudoSymbol","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Persisting--fetching-a-relationship","type":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"role":"pseudoSymbol","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext","kind":"section","type":"section","url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"kind":"article","role":"article","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","title":"Relationships","url":"\/tutorials\/table-of-contents\/relationships","abstract":[]},"migration-stages-2.swift":{"fileType":"swift","content":["import VeinCore","","enum Migration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ 1. Unchanged models must still be carried over","            try V0_0_1.Post.unchangedMigration(","                to: V0_0_2.Post.self,","                on: context","            )","","            \/\/ 2. Safely introduce the newly added optional fields","            try V0_0_1.Attachment.fieldsAddedMigration(","                to: V0_0_2.Attachment.self,","                on: context","            )","","            \/\/ 3. Drop tables\/data you no longer require","            try V0_0_1.Unused.deleteMigration(on: context)","        },","        didMigrate: nil","    )","}"],"syntax":"swift","fileName":"Migration.swift","identifier":"migration-stages-2.swift","type":"file","highlights":[]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Codable":{"url":"\/tutorials\/veincore\/custompersistable#Codable","role":"pseudoSymbol","title":"Codable","abstract":[{"type":"text","text":"Make your own types persistable."}],"type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Codable"},"migration-stages-1.swift":{"syntax":"swift","fileName":"Migration.swift","identifier":"migration-stages-1.swift","type":"file","fileType":"swift","content":["import VeinCore","","enum Migration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [","            V0_0_1.self,","            V0_0_2.self","        ]","    }","","    static var stages: [MigrationStage] {","        [","            migrateV1toV2","        ]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ Migration helpers will go here...","        },","        didMigrate: nil","    )","}"],"highlights":[]},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"estimatedTime":"7min","kind":"project","title":"Complex Migrations","url":"\/tutorials\/veincore\/complexmigrations","type":"topic","role":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}]},"migration-schemas.swift":{"fileType":"swift","content":["import VeinCore","","\/\/ Our baseline schema","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self,","        Unused.self","    ]","","    @Model final class Post { var title: String \/* ... *\/ }","    @Model final class Attachment { var name: String \/* ... *\/ }","    @Model final class Unused { var content: String \/* ... *\/ }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self","    ]","","    @Model final class Post { var title: String }","","    @Model final class Attachment {","        var name: String","","        \/\/ New optional field allows safe column additions","        var rating: Int?","    }","}"],"syntax":"swift","fileName":"Schemas.swift","identifier":"migration-schemas.swift","type":"file","highlights":[]},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing-full-migration-chain":{"role":"pseudoSymbol","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing-full-migration-chain","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"type":"section","title":"Unit Testing full migration chain","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain"},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"role":"article","kind":"article","abstract":[],"url":"\/tutorials\/table-of-contents\/custom-persistable","t