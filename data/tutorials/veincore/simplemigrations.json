         )","","            \/\/ 2. Safely introduce the newly added optional fields","            try V0_0_1.Attachment.fieldsAddedMigration(","                to: V0_0_2.Attachment.self,","                on: context","            )","","            \/\/ 3. Drop tables\/data you no longer require","            try V0_0_1.Unused.deleteMigration(on: context)","        },","        didMigrate: nil","    )","}"]},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","kind":"section","role":"pseudoSymbol","title":"Adding a relationship to our model","abstract":[{"type":"text","text":"Use relationships with VeinCore."}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"kind":"section","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext","type":"section","title":"ModelContainer & ManagedObjectContext","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"title":"Writing Custom Migration Logic","kind":"section","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"role":"pseudoSymbol"},"migration-stages-1.swift":{"fileType":"swift","syntax":"swift","identifier":"migration-stages-1.swift","content":["import VeinCore","","enum Migration: SchemaMigratio