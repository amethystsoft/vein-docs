tent":[{"inlineContent":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}],"type":"paragraph"}],"title":"Simple Database Migrations","kind":"hero","chapter":"Simple Migrations"},{"kind":"tasks","tasks":[{"title":"Migrating Schemas","stepsSection":[{"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Define your next schema version. In "},{"code":"V0_0_2","type":"codeVoice"},{"type":"text","text":", we declare our updated models."},{"type":"text","text":" "},{"type":"text","text":"Note that the new property "},{"code":"rating","type":"codeVoice"},{"type":"text","text":" must be an optional value."}],"type":"paragraph"}],"type":"step","media":null,"caption":[],"code":"migration-schemas.swift"},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now, create your "},{"type":"codeVoice","code":"SchemaMigrationPlan"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You list your supported schemas in chronological order and define the transitions in the "},{"type":"codeVoice","code":"stages"},{"type":"text","text":" array."}]}],"type":"step","media":null,"caption":[],"code":"migration-stages-1.swift"},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Inside the ","type":"text"},{"code":"willMigrate","type":"codeVoice"},{"text":" phase, utilize Vein’s migration helpers.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"unchangedMigration","type":"codeVoice"},{"text":" to keep a table intact, ","type":"text"},{"code":"deleteMigration","type":"codeVoice"},{"text":" to drop a table, and ","type":"text"},{"code":"fieldsAddedMigration","type":"codeVoice"},{"text":" to safely append the new optional column.","type":"text"}]}],"type":"step","media":null,"caption":[],"code":"migration-stages-2.swift"}],"anchor":"Migrating-Schemas","contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"As your app grows, you will inevitably need to change your data models."},{"type":"text","text":" "},{"type":"text","text":"Vein handles this through explicit, compile-time typesafe migrations."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In this guide, we will migrate from V0_0_1 to V0_0_2. During this change:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Post"},{"type":"text","text":" remains unchanged."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Attachment","type":"codeVoice"},{"text":" receives a new optional ","type":"text"},{"code":"rating","type":"codeVoice"},{"text":" field.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A legacy class "},{"type":"codeVoice","code":"Unused"},{"type":"text","text":" is completely deleted."}]}]}],"type":"unorderedList"}],"mediaPosition":"trailing"}]}]},{"action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","isActive":true,"overridingTitle":"Get started","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations"},"abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"title":"Complex Migrations","featuredEyebrow":"Tutorial","kind":"callToAction"}],"references":{"doc://VeinCore/tutorials/Table-of-Contents/Complex-Migrations":{"type":"topic","abstract":[],"title":"Complex Migrations","kind":"article","url":"\/tutorials\/table-of-contents\/complex-migrations","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations","role":"article"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Manual-Persistable":{"abstract":[{"type":"text","text":"Make your own types persistable."}],"url":"\/tutorials\/veincore\/custompersistable#Manual-Persistable","title":"Manual Persistable","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable","kind":"section","role":"pseudoSymbol"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","kind":"article","abstract":[],"role":"article","title":"Simple Migrations","url":"\/tutorials\/table-of-contents\/simple-migrations","type":"topic"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","kind":"section","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"title":"Adding a relationship to our model","url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","role":"pseudoSymbol"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","role":"article","title":"Quick start","url":"\/tutorials\/table-of-contents\/quick-start","abstract":[],"kind":"article"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"type":"section","title":"ModelContainer & ManagedObjectContext","kind":"section","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"kind":"section","type":"section","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor":{"type":"section","abstract":[{"type":"text","text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries."}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor","title":"FetchDescriptor and PaginatedFetchDescriptor","role":"pseudoSymbol","url":"\/tutorials\/veincore\/advancedqueries#FetchDescriptor-and-PaginatedFetchDescriptor"},"migration-stages-2.swift":{"fileName":"Migration.swift","fileType":"swift","highlights":[],"identifier":"migration-stages-2.swift","content":["import VeinCore","","enum Migration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ 1. Unchanged models must still be carried over","            try V0_0_1.Post.unchangedMigration(","                to: V0_0_2.Post.self,","                on: context","            )","","            \/\/ 2. Safely introduce the newly added optional fields","            try V0_0_1.Attachment.fieldsAddedMigration(","                to: V0_0_2.Attachment.self,","                on: context","            )","","            \/\/ 3. Drop tables\/data you no longer require","            try V0_0_1.Unused.deleteMigration(on: context)","        },","        didMigrate: nil","    )","}"],"syntax":"swift","type":"file"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"abstract":[{"type":"text","text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions."}],"role":"pseudoSymbol","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","kind":"section","title":"Migrating Schemas","type":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"url":"\/tutorials\/veincore\/quick-start-xcode#Setup","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","title":"Setup","kind":"section"},"migration-stages-1.swift":{"fileName":"Migration.swift","syntax":"swift","content":["import VeinCore","","enum Migration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [","            V0_0_1.self,","            V0_0_2.self","        ]","    }","","    static var stages: [MigrationStage] {","        [","            migrateV1toV2","        ]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ Migration helpers will go here...","        },","        didMigrate: nil","    )","}"],"type":"file","highlights":[],"fileType":"swift","identifier":"migration-stages-1.swift"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"type":"section","title":"Unit Testing","role":"pseudoSymbol","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing"},"doc://VeinCore/tutorials/