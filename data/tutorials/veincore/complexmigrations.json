{"kind":"project","sections":[{"chapter":"Complex Migrations","title":"Complex Migrations","kind":"hero","estimatedTimeInMinutes":7,"content":[{"inlineContent":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"stepsSection":[{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Define the baseline and destination schemas. Notice that ","type":"text"},{"type":"codeVoice","code":"V0_0_2.Test"},{"text":" now requires a non-optional ","type":"text"},{"type":"codeVoice","code":"securityCode"},{"text":" instead of ","type":"text"},{"type":"codeVoice","code":"randomValue"},{"text":", meaning simple column additions won’t work.","type":"text"}]}],"caption":[],"media":null,"code":"complex-migration-schemas.swift","type":"step"},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set up your "},{"type":"codeVoice","code":"SchemaMigrationPlan"},{"type":"text","text":" block, preparing a "},{"type":"codeVoice","code":".complex"},{"type":"text","text":" transition stage from version 1 to version 2."}]}],"caption":[],"media":null,"code":"complex-migration-stages-1.swift","type":"step"},{"runtimePreview":null,"content":[{"inlineContent":[{"text":"Implement the migration logic. Fetch the baseline records, execute your custom business rules, and save the mapped models back to the new schema inside the transition step.","type":"text"}],"type":"paragraph"}],"caption":[],"media":null,"code":"complex-migration-stages-2.swift","type":"step"}],"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"inlineContent":[{"text":"Simple migration helpers are great for adding fields or dropping tables. However, when you rename fields, merge schemas, or modify non-optional data types (like mapping an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" to a formatted ","type":"text"},{"code":"String","type":"codeVoice"},{"text":"), you need a custom migration.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In this tutorial, we will migrate from ","type":"text"},{"code":"V0_0_1","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"V0_0_2","type":"codeVoice"},{"text":" where we:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Map an old model’s field "},{"type":"codeVoice","code":"randomValue"},{"type":"text","text":" (Int) into a formatted "},{"type":"codeVoice","code":"securityCode"},{"type":"text","text":" (String)."}]}]},{"content":[{"inlineContent":[{"text":"Apply processing rules during the transfer (clamping negative numbers to zero).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"anchor":"Writing-Custom-Migration-Logic","title":"Writing Custom Migration Logic"}]},{"abstract":[{"text":"Make your own types persistable.","type":"text"}],"kind":"callToAction","title":"Custom Persistable","action":{"isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","type":"reference"},"featuredEyebrow":"Tutorial"}],"hierarchy":{"paths":[["doc:\/\/VeinCore\/tutorials\/Table-of-Contents","doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/$volume","doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations"]],"modules":[{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup"},{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Create-your-first-Model"},{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext"}],"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package"},{"sections":[{"reference":"doc: