: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ Custom mapping logic will go here","        },","        didMigrate: nil","    )","}"],"fileName":"Migration.swift","fileType":"swift","syntax":"swift","identifier":"complex-migration-stages-1.swift","highlights":[],"type":"file"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"role":"project","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"kind":"project","estimatedTime":"7min","title":"Complex Migrations","url":"\/tutorials\/veincore\/complexmigrations"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing-full-migration-chain":{"role":"pseudoSymbol","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing-full-migration-chain","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain","kind":"section","type":"section","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"title":"Unit Testing full migration chain"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","abstract":[{"text":"Make your own types persistable.","type":"text"}],"url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","role":"pseudoSymbol","title":"RawRepresentable"},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"kind":"article","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","title":"Unit Testing Migrations","url":"\/tutorials\/table-of-contents\/unit-testing-migrations","abstract":[],"type":"topic"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations":{"estimatedTime":"5min","type":"topic","abstract":[{"type":"text","text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions."}],"role":"project","kind":"project","title":"Simple Database Migrations","url":"\/tutorials\/veincore\/simplemigrations","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"title":"Adding a relationship to our model","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","kind":"section","url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","type":"section"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"kind":"section","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","abstract":[{"type":"text","text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions."}],"role":"pseudoSymbol","title":"Migrating Schemas","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","type":"section"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Manual-Persistable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable","url":"\/tutorials\/veincore\/custompersistable#Manual-Persistable","role":"pseudoSymbol","kind":"section","abstract":[{"type":"text","text":"Make your own types persistable."}],"type":"section","title":"Manual Persistable"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#The-migration-we-are-going-to-test":{"title":"The migration we are going to test:","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"role":"pseudoSymbol","url":"\/tutorials\/veincore\/migrationunittests#The-migration-we-are-going-to-test","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","kind":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","kind":"section","title":"Setup","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","role":"pseudoSymbol","type":"section"},"doc://VeinCore/tutorials/VeinCore/Relationships":{"title":"Relationships","role":"project","kind":"project","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"url":"\/tutorials\/veincore\/relationships","estimatedTime":"3min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships","type":"topic"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext","role":"pseudoSymbol","type":"section","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"role":"pseudoSymbol","type":"section","title":"Setup","url":"\/tutorials\/veincore\/quick-start-xcode#Setup","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","kind":"section"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"title":"Simple Migrations","role":"article","url":"\/tutorials\/table-of-contents\/simple-migrations","type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations"},"complex-migration-stages-2.swift":{"fileType":"swift","content":["import VeinCore","","enum ComplexMigration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ 1. Fetch current models from the V1 database setup","            let oldTests = try context.fetchAll(V0_0_1.Test.self)","","            \/\/ 2. Map old entries to new types individually","            for test in oldTests {","                let sanitizedValue = max(0, test.randomValue)","","                let newTest = V0_0_2.Test(","                    flag: test.flag,","                    someValue: test.someValue,","                    securityCode: \"SEC-\\(sanitizedValue)\"","                )","","                \/\/ Add the new instance and remove the old one.","                \/\/ If a migration has unhandled non-empty tables at the end it will fail.","                try context.insert(newTest)","                try context.delete(test)","            }","        },","        didMigrate: nil","    )","}"],"type":"file","syntax":"swift","fileName":"Migration.swift","identifier":"complex-migration-stages-2.swift","highlights":[]},"doc://VeinCore/tutorials/VeinCore/Relationships#Persisting--fetching-a-relationship":{"url":"\/tutorials\/veincore\/relationships#Persisting--fetching-a-relationship","title":"Persisting & fetching a relationship","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Persisting--fetching-a-relationship","role":"pseudoSymbol"},"complex-migration-schemas.swift":{"fileName":"Schemas.swift","highlights":[],"type":"file","fileType":"swift","syntax":"swift","content":["import VeinCore","","\/\/ Our baseline schema","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Test.self","    ]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var randomValue: Int","","        init(flag: Bool, someValue: String, randomValue: Int) {","            self.flag = flag","            self.someValue = someValue","            self.randomValue = randomValue","        }","    }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [Test.self]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var securityCode: String \/\/ This replaces the old raw Int","","        init(flag: Bool, someValue: String, securityCode: String) {","            self.flag = flag","            self.someValue = someValue","            self.securityCode = securityCode","        }","    }","}"],"identifier":"complex-migration-schemas.swift"},"doc://VeinCore/tutorials/Table-of-Contents/Complex-Migrations":{"abstract":[],"role":"article","kind":"article","type":"topic","url":"\/tutorials\/table-of-contents\/complex-migrations","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations","title":"Complex Migrations"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","title":"Unit Testing","kind":"section","type":"section","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"role":"pseudoSymbol","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing"}}}