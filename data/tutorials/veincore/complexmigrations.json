{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/veincore\/complexmigrations"]}],"sections":[{"chapter":"Complex Migrations","content":[{"type":"paragraph","inlineContent":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}]}],"kind":"hero","estimatedTimeInMinutes":7,"title":"Complex Migrations"},{"tasks":[{"stepsSection":[{"content":[{"inlineContent":[{"text":"Define the baseline and destination schemas. Notice that ","type":"text"},{"type":"codeVoice","code":"V0_0_2.Test"},{"text":" now requires a non-optional ","type":"text"},{"type":"codeVoice","code":"securityCode"},{"text":" instead of ","type":"text"},{"type":"codeVoice","code":"randomValue"},{"text":", meaning simple column additions won’t work.","type":"text"}],"type":"paragraph"}],"media":null,"code":"complex-migration-schemas.swift","runtimePreview":null,"caption":[],"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set up your ","type":"text"},{"type":"codeVoice","code":"SchemaMigrationPlan"},{"text":" block, preparing a ","type":"text"},{"type":"codeVoice","code":".complex"},{"text":" transition stage from version 1 to version 2.","type":"text"}]}],"media":null,"code":"complex-migration-stages-1.swift","runtimePreview":null,"caption":[],"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Implement the migration logic. Fetch the baseline records, execute your custom business rules, and save the mapped models back to the new schema inside the transition step.","type":"text"}]}],"media":null,"code":"complex-migration-stages-2.swift","runtimePreview":null,"caption":[],"type":"step"}],"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Simple migration helpers are great for adding fields or dropping tables. However, when you rename fields, merge schemas, or modify non-optional data types (like mapping an "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" to a formatted "},{"code":"String","type":"codeVoice"},{"type":"text","text":"), you need a custom migration."}],"type":"paragraph"},{"inlineContent":[{"text":"In this tutorial, we will migrate from ","type":"text"},{"type":"codeVoice","code":"V0_0_1"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"V0_0_2"},{"text":" where we:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Map an old model’s field ","type":"text"},{"type":"codeVoice","code":"randomValue"},{"text":" (Int) into a formatted ","type":"text"},{"type":"codeVoice","code":"securityCode"},{"type":"text","text":" (String)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply processing rules during the transfer (clamping negative numbers to zero)."}]}]}],"type":"unorderedList"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"Writing-Custom-Migration-Logic","title":"Writing Custom Migration Logic"}],"kind":"tasks"},{"abstract":[{"text":"Make your own types persistable.","type":"text"}],"action":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","isActive":true,"overridingTitle":"Get started"},"kind":"callToAction","title":"Custom Persistable","featuredEyebrow":"Tutorial"}],"identifier":{"url":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","interfaceLanguage":"swift"},"metadata":{"categoryPathComponent":"Table-of-Contents","role":"project","category":"Vein","title":"Complex Migrations"},"hierarchy":{"modules":[{"projects":[{"sections":[{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","kind":"task"},{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Create-your-first-Model","kind":"task"},{"reference":"doc:\/\/VeinCore\/tutorials\/Vei