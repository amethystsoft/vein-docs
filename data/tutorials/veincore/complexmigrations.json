\/complex-migrations","kind":"article"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"abstract":[],"type":"topic","url":"\/tutorials\/table-of-contents\/simple-migrations","kind":"article","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","title":"Simple Migrations"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"title":"Relationships","type":"topic","kind":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","url":"\/tutorials\/table-of-contents\/relationships","abstract":[],"role":"article"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","role":"pseudoSymbol","title":"Adding a relationship to our model","kind":"section","type":"section","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}]},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"title":"Unit Testing Migrations","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","kind":"article","role":"article","url":"\/tutorials\/table-of-contents\/unit-testing-migrations","abstract":[]},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"type":"section","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","title":"Writing Custom Migration Logic","role":"pseudoSymbol","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic"},"doc://VeinCore/tutorials/Table-of-Contents/Advanced-Queries":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Advanced-Queries","url":"\/tutorials\/table-of-contents\/advanced-queries","role":"article","type":"topic","abstract":[],"kind":"article","title":"Advanced Queries"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"type":"topic","url":"\/tutorials\/veincore\/migrationunittests","kind":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests","title":"Unit Testing Migrations","role":"project","estimatedTime":"10min","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}]},"complex-migration-schemas.swift":{"highlights":[],"fileType":"swift","identifier":"complex-migration-schemas.swift","syntax":"swift","fileName":"Schemas.swift","content":["import VeinCore","","\/\/ Our baseline schema","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Test.self","    ]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var randomValue: Int","","        init(flag: Bool, someValue: String, randomValue: Int) {","            self.flag = flag","            self.someValue = someValue","            self.randomValue = randomValue","        }","    }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [Test.self]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var securityCode: String \/\/ This replaces the old raw Int","","        init(flag: Bool, someValue: String, securityCode: String) {","            self.flag = flag","            self.someValue = someValue","            self.securityCode = securityCode","        }","    }","}"],"type":"file"},"complex-migration-stages-1.swift":{"content":["import VeinCore","","enum ComplexMigration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ Custom mapping logic will go here","        },","        didMigrate: nil","    )","}"],"fileName":"Migration.swift","type":"file","syntax":"swift","highlights":[],"identifier":"complex-migration-stages-1.swift","fileType":"swift"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries":{"role":"project","title":"Advanced Queries","url":"\/tutorials\/veincore\/advancedqueries","kind":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"estimatedTime":"5min","type":"topic"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","role":"pseudoSymbol","type":"section","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"title":"Unit Testing","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing","kind":"section"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"title":"Migrating Schemas","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","type":"section","role":"pseudoSymbol","abstract":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.