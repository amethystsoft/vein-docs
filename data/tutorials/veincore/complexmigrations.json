,{"type":"codeVoice","code":"securityCode"},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"randomValue"},{"type":"text","text":", meaning simple column additions won’t work."}]}],"caption":[],"code":"complex-migration-schemas.swift","runtimePreview":null,"type":"step","media":null},{"content":[{"inlineContent":[{"text":"Set up your ","type":"text"},{"code":"SchemaMigrationPlan","type":"codeVoice"},{"type":"text","text":" block, preparing a "},{"code":".complex","type":"codeVoice"},{"type":"text","text":" transition stage from version 1 to version 2."}],"type":"paragraph"}],"caption":[],"code":"complex-migration-stages-1.swift","runtimePreview":null,"type":"step","media":null},{"content":[{"inlineContent":[{"text":"Implement the migration logic. Fetch the baseline records, execute your custom business rules, and save the mapped models back to the new schema inside the transition step.","type":"text"}],"type":"paragraph"}],"media":null,"code":"complex-migration-stages-2.swift","caption":[],"runtimePreview":null,"type":"step"}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple migration helpers are great for adding fields or dropping tables. However, when you rename fields, merge schemas, or modify non-optional data types (like mapping an "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" to a formatted "},{"code":"String","type":"codeVoice"},{"type":"text","text":"), you need a custom migration."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this tutorial, we will migrate from "},{"type":"codeVoice","code":"V0_0_1"},{"type":"text","text":" to "},{"type":"codeVoice","code":"V0_0_2"},{"type":"text","text":" where we:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Map an old model’s field "},{"type":"codeVoice","code":"randomValue"},{"type":"text","text":" (Int) into a formatted "},{"type":"codeVoice","code":"securityCode"},{"type":"text","text":" (String)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Apply processing rules during the transfer (clamping negative numbers to zero).","type":"text"}]}]}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}]}]},{"title":"Custom Persistable","kind":"callToAction","featuredEyebrow":"Tutorial","abstract":[{"text":"Make your own types persistable.","type":"text"}],"action":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference"}}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations"},"kind":"project","variants":[{"paths":["\/tutorials\/veincore\/complexmigrations"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"kind":"section","abstract":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}],"title":"Migrating Schemas","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","type":"section","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"type":"section","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","title":"Setup","kind":"section","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}]},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"estimatedTime":"7min","kind":"project","title":"Complex Migrations","url":"\/tutorials\/veincore\/complexmigrations","type":"topic","role":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}]},"doc://VeinCore/tutorials/VeinCore/Relationships#Persisting--fetching-a-relationship":{"title":"Persisting & fetching a relationship","url":"\/tutorials\/veincore\/relationships#Persisting--fetching-a-relationship","role":"pseudoSymbol","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Persisting--fetching-a-relationship","type":"section"},"doc://VeinCore/tutorials/VeinCore/Relationships":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships","url":"\/tutorials\/veincore\/relationships","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"title":"Relationships","type":"topic","estimatedTime":"3min","kind":"project","role":"project"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","abstract":[{"type":"text","text":"Make your own types persistable."}],"title":"RawRepresentable","role":"pseudoSymbol","type":"section","kind":"section"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"title":"Unit Testing Migrations","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"kind":"project","role":"project","url":"\/tutorials\/veincore\/migrationunittests","estimatedTime":"10min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests","type":"topic"},"doc://VeinCore/tutorials/Table-of-Contents":{"type":"topic","title":"Meet Vein","kind":"overview","abstract":[{"text":"Database for apps made easy.","type":"text"}],"role":"overview","url":"\/tutorials\/table-of-contents","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"type":"topic","url":"\/tutorials\/table-of-contents\/quick-start","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","kind":"article","role":"article","title":"Quick start"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"title":"Create your first Model","role":"pseudoSymbol","type":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","kind":"section"},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"role":"article","kind":"article","abstract":[],"url":"\/tutorials\/table-of-contents\/custom-persistable","title":"Custom Persistable","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable","type":"topic"},"complex-migration-stages-1.swift":{"fileName":"Migration.swift","identifier":"complex-migration-stages-1.swift","highlights":[],"syntax":"swift","fileType":"swift","type":"file","content":["import VeinCore","","enum ComplexMigration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ Custom mapping logic will go here","        },","        didMigrate: nil","    )","}"]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Manual-Persistable":{"abstract":[{"text":"Make your own types persistable.","type":"text"}],"kind":"section","title":"Manual Persistable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable","url":"\/tutorials\/veincore\/custompersistable#Manual-Persistable","type":"section","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","type":"section","kind":"section","url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","title":"Adding a relationship to our model","abstract":[{"type":"text","text":"Use relationships with VeinCore."}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","title":"Setup","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#Setup","kind":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode":{"url":"\/tutorials\/veincore\/quick-start-xcode","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"role":"project","type":"topic","kind":"project","title":"Quick start Xcode","estimatedTime":"5min"},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","role":"article","kind":"article","title":"Unit Testing Migrations","url":"\/tutorials\/table-of-contents\/unit-testing-migrations"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package":{"title":"Quick start Swift Package","estimatedTime":"5min","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"type":"topic","url":"\/tutorials\/veincore\/quick-start-swift-package","kind":"project","role":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","kind":"article","title":"Simple Migrations","role":"article","url":"\/tutorials\/table-of-contents\/simple-migrations","abstract":[],"type":"topic"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing-full-migration-chain":{"role":"pseudoSymbol","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing-full-migration-chain","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"type":"section","title":"Unit Testing full migration chain","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"kind":"article","role":"article","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","title":"Relationships","url":"\/tutorials\/table-of-contents\/relationships","abstract":[]},"complex-migration-stages-2.swift":{"type":"file","fileName":"Migration.swift","syntax":"swift","highlights":[],"content":["import VeinCore","","enum ComplexMigration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ 1. Fetch current models from the V1 database setup","            let oldTests = try context.fetchAll(V0_0_1.Test.self)","","            \/\/ 2. Map old entries to new types individually","            for test in oldTests {","                let sanitizedValue = max(0, test.randomValue)","","                let newTest = V0_0_2.Test(","                    flag: test.flag,","                    someValue: test.someValue,","                    securityCode: \"SEC-\\(sanitizedValue)\"","                )","","                \/\/ Add the new instance and remove the old one.","                \/\/ If a migration has unhandled non-empty tables at the end it will fail.","                try context.insert(newTest)","                try context.delete(test)","            }","        },","        didMigrate: nil","    )","}"],"fileType":"swift","identifier":"complex-migration-stages-2.swift"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"title":"Custom Persistable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","abstract":[{"type":"text","text":"Make your own types persistable."}],"url":"\/tutorials\/veincore\/custompersistable","kind":"project","estimatedTime":"5min","type":"topic","role":"project"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"role":"pseudoSymbol","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext","kind":"section","type":"section","url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext"},"complex-migration-schemas.swift":{"type":"file","identifier":"complex-migration-schemas.swift","syntax":"swift","highlights":[],"fileName":"Schemas.swift","fileType":"swift","content":["import VeinCore","","\/\/ Our baseline schema","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Test.self","    ]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var randomValue: Int","","        init(flag: Bool, someValue: String, randomValue: Int) {","            self.flag = flag","            self.someValue = someValue","            self.randomValue = randomValue","        }","    }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [Test.self]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var securityCode: String \/\/ This replaces the old raw Int","","        init(flag: Bool, someValue: String, securityCode: String) {","            self.flag = flag","            self.someValue = someValue","            self.securityCode = securityCode","        }","    }","}"]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"role":"pseudoSymbol","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"type":"section","title":"ModelContainer & ManagedObjectContext","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","kind":"section"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations":{"estimatedTime":"5min","type":"topic","kind":"project","role":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations","abstract":[{"type":"text","text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions."}],"title":"Simple Database Migrations","url":"\/tutorials\/veincore\/simplemigrations"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#The-migration-we-are-going-to-test":{"type":"section","title":"The migration we are going to test:","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","url":"\/tutorials\/veincore\/migrationunittests#The-migration-we-are-going-to-test","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Create-your-first-Model":{"title":"Create your first Model","role":"pseudoSymbol","type":"section","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Create-your-first-Model","url":"\/tutorials\/veincore\/quick-start-swift-package#Create-your-first-Model","kind":"section"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"kind":"section","type":"section","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"title":"Writing Custom Migration Logic","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Codable":{"url":"\/tutorials\/veincore\/custompersistable#Codable","role":"pseudoSymbol","title":"Codable","abstract":[{"type":"text","text":"Make your own types persistable."}],"type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Codable"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"role":"pseudoSymbol","title":"Unit Testing","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"kind":"section","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing"},"doc://VeinCore/tutorials/Table-of-Contents/Complex-Migrations":{"type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations","kind":"article","title":"Complex Migrations","abstract":[],"role":"article","url":"\/tutorials\/table-of-contents\/complex-migrations"}}}