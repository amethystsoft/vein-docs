ctural database transformations by fetching existing models and inserting new ones."}],"type":"topic"},"doc://VeinCore/tutorials/Table-of-Contents":{"kind":"overview","title":"Meet Vein","role":"overview","url":"\/tutorials\/table-of-contents","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","abstract":[{"text":"Database for apps made easy.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"url":"\/tutorials\/veincore\/quick-start-xcode#Setup","kind":"section","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","type":"section","title":"Setup","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"kind":"section","title":"ModelContainer & ManagedObjectContext","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package":{"abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"title":"Quick start Swift Package","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package","estimatedTime":"5min","url":"\/tutorials\/veincore\/quick-start-swift-package","type":"topic","role":"project","kind":"project"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"title":"Writing Custom Migration Logic","kind":"section","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Codable":{"url":"\/tutorials\/veincore\/custompersistable#Codable","kind":"section","abstract":[{"type":"text","text":"Make your own types persistable."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Codable","type":"section","title":"Codable","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"kind":"section","title":"Setup","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#The-migration-we-are-going-to-test":{"role":"pseudoSymbol","title":"The migration we are going to test:","url":"\/tutorials\/veincore\/migrationunittests#The-migration-we-are-going-to-test","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","type":"section","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations":{"url":"\/tutorials\/veincore\/simplemigrations","title":"Simple Database Migrations","estimatedTime":"5min","role":"project","type":"topic","abstract":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations","kind":"project"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"kind":"article","title":"Simple Migrations","role":"article","url":"\/tutorials\/table-of-contents\/simple-migrations","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","abstract":[]},"complex-migration-stages-2.swift":{"syntax":"swift","content":["import VeinCore","","enum ComplexMigration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ 1. Fetch current models from the V1 database setup","            let oldTests = try context.fetchAll(V0_0_1.Test.self)","","            \/\/ 2. Map old entries to new types individually","            for test in oldTests {","                let sanitizedValue = max(0, test.randomValue)","","                let newTest = V0_0_2.Test(","                    flag: test.flag,","                    someValue: test.someValue,","                    securityCode: \"SEC-\\(sanitizedValue)\"","                )","","                \/\/ Add the new instance and remove the old one.","                \/\/ If a migration has unhandled non-empty tables at the end it will fail.","                try context.insert(newTest)","                try context.delete(test)","            }","        },","        didMigrate: nil","    )","}"],"fileType":"swift","type":"file","highlights":[],"identifier":"complex-migration-stages-2.swift","fileName":"Migration.swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","role":"pseudoSymbol","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","kind":"section","title":"Create your first Model"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","url":"\/tutorials\/veincore\/custompersistable","title":"Custom Persistable","abstract":[{"type":"text","text":"Make your own types persistable."}],"role":"project","type":"topic","estimatedTime":"5min","kind":"project"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"role":"pseudoSymbol","title":"Migrating Schemas","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","abstract":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}],"type":"section"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"title":"RawRepresentable","url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","role":"pseudoSymbol","type":"section","abstract":[{"type":"text","text":"Make your own types persistable."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","kind":"section"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"url":"\/tutorials\/veincore\/migrationunittests","role":"project","type":"topic","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"title":"Unit Testing Migrations","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode":{"role":"project","title":"Quick start Xcode","url":"\/tutorials\/veincore\/quick-start-xcode","kind":"project","estimatedTime":"5min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"type":"topic"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Manual-Persistable":{"role":"pseudoSymbol","abstract":[{"type":"text","text":"Make your own types persistable."}],"type":"section","url":"\/tutorials\/veincore\/custompersistable#Manual-Persistable","title":"Manual Persistable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable","kind":"section"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","title":"Unit Testing","role":"pseudoSymbol","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing","kind":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"kind":"section","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext","type":"section","title":"ModelContainer & ManagedObjectContext","role":"pseudoSymbol"},"doc://VeinCore/tutorials/Table-of-Contents/Complex-Migrations":{"type":"topic","role":"article","url":"\/tutorials\/table-of-contents\/complex-migrations","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations","title":"Complex Migrations","abstract":[],"kind":"article"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing-full-migration-chain":{"url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing-full-migration-chain","title":"Unit Testing full migration chain","role":"pseudoSymbol","type":"section","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain","kind":"section"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"title":"Quick start","url":"\/tutorials\/table-of-contents\/quick-start","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","kind":"article"},"complex-migration-stages-1.swift":{"identifier":"complex-migration-stages-1.swift","fileType":"swift","content":["import VeinCore","","enum ComplexMigration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ Custom mapping logic will go here","        },","        didMigrate: nil","    )","}"],"syntax":"swift","type":"file","highlights":[],"fileName":"Migration.swift"},"complex-migration-schemas.swift":{"type":"file","syntax":"swift","fileName":"Schemas.swift","identifier":"complex-migration-schemas.swift","content":["import VeinCore","","\/\/ Our baseline schema","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Test.self","    ]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var randomValue: Int","","        init(flag: Bool, someValue: String, randomValue: Int) {","            self.flag = flag","            self.someValue = someValue","            self.randomValue = randomValue","        }","    }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [Test.self]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var securityCode: String \/\/ This replaces the old raw Int","","        init(flag: Bool, someValue: String, securityCode: String) {","            self.flag = flag","            self.someValue = someValue","            self.securityCode = securityCode","        }","    }","}"],"highlights":[],"fileType":"swift"},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"title":"Custom Persistable","url":"\/tutorials\/table-of-contents\/custom-persistable","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable","kind":"article"},"doc://VeinCore/tutorials/VeinCore/Relationships":{"kind":"project","url":"\/tutorials\/veincore\/relationships","type":"topic","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"estimatedTime":"3min","role":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships","title":"Relationships"},"doc://VeinCore/tutorials/Table-of-Contents/Advanced-Queries":{"title":"Advanced Queries","url":"\/tutorials\/table-of-contents\/advanced-queries","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Advanced-Queries","kind":"article"},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"title":"Unit Testing Migrations","url":"\/tutorials\/table-of-contents\/unit-testing-migrations","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","kind":"article"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","kind":"section","role":"pseudoSymbol","title":"Adding a relationship to our model","abstract":[{"type":"text","text":"Use relationships with VeinCore."}]},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries":{"title":"Advanced Queries","url":"\/tutorials\/veincore\/advancedqueries","estimatedTime":"5min","role":"project","type":"topic","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries","kind":"project"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Create-your-first-Model":{"type":"section","kind":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"title":"Create your first Model","url":"\/tutorials\/veincore\/quick-start-swift-package#Create-your-first-Model","role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Create-your-first-Model"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"title":"Relationships","url":"\/tutorials\/table-of-contents\/relationships","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","kind":"article"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor":{"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor","url":"\/tutorials\/veincore\/advancedqueries#FetchDescriptor-and-PaginatedFetchDescriptor","type":"section","abstract":[{"type":"text","text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries."}],"role":"pseudoSymbol","title":"FetchDescriptor and PaginatedFetchDescriptor"}}}