ginate queries.","type":"text"}],"url":"\/tutorials\/veincore\/advancedqueries#FetchDescriptor-and-PaginatedFetchDescriptor","title":"FetchDescriptor and PaginatedFetchDescriptor"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"abstract":[{"text":"Make your own types persistable.","type":"text"}],"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","title":"RawRepresentable"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Create-your-first-Model":{"type":"section","url":"\/tutorials\/veincore\/quick-start-swift-package#Create-your-first-Model","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Create-your-first-Model","title":"Create your first Model","role":"pseudoSymbol","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Manual-Persistable":{"role":"pseudoSymbol","url":"\/tutorials\/veincore\/custompersistable#Manual-Persistable","abstract":[{"type":"text","text":"Make your own types persistable."}],"title":"Manual Persistable","kind":"section","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext","role":"pseudoSymbol","title":"ModelContainer & ManagedObjectContext","kind":"section","type":"section"},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"abstract":[],"type":"topic","url":"\/tutorials\/table-of-contents\/custom-persistable","kind":"article","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable","title":"Custom Persistable"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"url":"\/tutorials\/table-of-contents\/quick-start","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","title":"Quick start","kind":"article","type":"topic","abstract":[]},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"title":"Complex Migrations","type":"topic","url":"\/tutorials\/veincore\/complexmigrations","role":"project","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","kind":"project","estimatedTime":"7min"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"type":"section","role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","title":"Create your first Model","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"kind":"section"},"complex-migration-stages-2.swift":{"content":["import VeinCore","","enum ComplexMigration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ 1. Fetch current models from the V1 database setup","            let oldTests = try context.fetchAll(V0_0_1.Test.self)","","            \/\/ 2. Map old entries to new types individually","            for test in oldTests {","                let sanitizedValue = max(0, test.randomValue)","","                let newTest = V0_0_2.Test(","                    flag: test.flag,","                    someValue: test.someValue,","                    securityCode: \"SEC-\\(sanitizedValue)\"","                )","","                \/\/ Add the new instance and remove the old one.","                \/\/ If a migration has unhandled non-empty tables at the end it will fail.","                try context.insert(newTest)","                try context.delete(test)","            }","        },","        didMigrate: nil","    )","}"],"fileName":"Migration.swift","type":"file","syntax":"swift","highlights":[],"identifier":"complex-migration-stages-2.swift","fileType":"swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"type":"section","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"kind":"section","title":"ModelContainer & ManagedObjectContext","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"type":"section","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"kind":"section","title":"Setup","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","title":"Setup","url":"\/tutorials\/veincore\/quick-start-xcode#Setup","role":"pseudoSymbol","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"type":"section","kind":"section"},"doc://VeinCore/tutorials/VeinCore/Migrat