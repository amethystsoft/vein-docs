inCore/Quick-start-Xcode":{"estimatedTime":"5min","url":"\/tutorials\/veincore\/quick-start-xcode","type":"topic","role":"project","kind":"project","title":"Quick start Xcode","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/Table-of-Contents":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","title":"Meet Vein","url":"\/tutorials\/table-of-contents","type":"topic","kind":"overview","abstract":[{"text":"Database for apps made easy.","type":"text"}],"role":"overview"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"estimatedTime":"10min","url":"\/tutorials\/veincore\/migrationunittests","type":"topic","role":"project","kind":"project","title":"Unit Testing Migrations","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","title":"Custom Persistable","url":"\/tutorials\/veincore\/custompersistable","type":"topic","kind":"project","estimatedTime":"5min","abstract":[{"text":"Make your own types persistable.","type":"text"}],"role":"project"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","title":"Relationships","url":"\/tutorials\/table-of-contents\/relationships","type":"topic","kind":"article","abstract":[],"role":"article"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","type":"section","role":"pseudoSymbol","title":"Setup","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable","role":"article","url":"\/tutorials\/table-of-contents\/custom-persistable","title":"Custom Persistable"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","type":"section","kind":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","title":"Complex Migrations","url":"\/tutorials\/veincore\/complexmigrations","type":"topic","kind":"project","estimatedTime":"7min","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"role":"project"},"complex-migration-schemas.swift":{"identifier":"complex-migration-schemas.swift","content":["import VeinCore","","\/\/ Our baseline schema","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Test.self","    ]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var randomValue: Int","","        init(flag: Bool, someValue: String, randomValue: Int) {","            self.flag = flag","            self.someValue = someValue","            self.randomValue = randomValue","        }","    }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [Test.self]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var securityCode: String \/\/ This replaces the old raw Int","","        init(flag: Bool, someValue: String, securityCode: String) {","            self.flag = flag","            self.someValue = someValue","            self.securityCode = securityCode","        }","    }","}"],"fileName":"Schemas.swift","type":"file","syntax":"swift","fileType":"swift","highlights":[]},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","title":"Quick start","url":"\/tutorials\/table-of-contents\/quick-start","type":"topic","kind":"article","abstract":[],"role":"article"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package":{"kind":"project","type":"topic","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package","role":"project","url":"\/tutorials\/veincore\/quick-start-swift-package","estimatedTime":"5min","title":"Quick start Swift Package"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"kind":"section","type":"section","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","role":"pseudoSymbol","url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","title":"Adding a relationship to our model"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Codable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Codable","title":"Codable","url":"\/tutorials\/veincore\/custompersistable#Codable","type":"section","kind":"section","abstract":[{"text":"Make your own types persistable.","type":"text"}],"role":"pseudoSymbol"}}}