":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","sections":[{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","kind":"task"}]}],"reference":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations"},{"projects":[{"sections":[{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","kind":"task"},{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Codable","kind":"task"},{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable","kind":"task"}],"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable"}],"reference":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable"},{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test"},{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing"},{"kind":"task","reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain"}],"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests"}],"reference":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations"}],"paths":[["doc:\/\/VeinCore\/tutorials\/Table-of-Contents","doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/$volume","doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations"]],"reference":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents"},"metadata":{"title":"Complex Migrations","categoryPathComponent":"Table-of-Contents","role":"project","category":"Vein"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/veincore\/complexmigrations"]}],"kind":"project","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[{"kind":"hero","title":"Complex Migrations","estimatedTimeInMinutes":7,"content":[{"inlineContent":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"type":"paragraph"}],"chapter":"Complex Migrations"},{"kind":"tasks","tasks":[{"anchor":"Writing-Custom-Migration-Logic","stepsSection":[{"type":"step","runtimePreview":null,"caption":[],"media":null,"content":[{"inlineContent":[{"text":"Define the baseline and destination schemas. Notice that ","type":"text"},{"code":"V0_0_2.Test","type":"codeVoice"},{"text":" now requires a non-optional ","type":"text"},{"code":"securityCode","type":"codeVoice"},{"text":" instead of ","type":"text"},{"code":"randomValue","type":"codeVoice"},{"text":", meaning simple column additions won’t work.","type":"text"}],"type":"paragraph"}],"code":"complex-migration-schemas.swift"},{"type":"step","runtimePreview":null,"caption":[],"media":null,"content":[{"inlineContent":[{"text":"Set up your ","type":"text"},{"code":"SchemaMigrationPlan","type":"codeVoice"},{"text":" block, preparing a ","type":"text"},{"code":".complex","type":"codeVoice"},{"text":" transition stage from version 1 to version 2.","type":"text"}],"type":"paragraph"}],"code":"complex-migration-stages-1.swift"},{"type":"step","runtimePreview":null,"caption":[],"media":null,"content":[{"inlineContent":[{"text":"Implement the migration logic. Fetch the baseline records, execute your custom business rules, and save the mapped models back to the new schema inside the transition step.","type":"text"}],"type":"paragraph"}],"code":"complex-migration-stages-2.swift"}],"title":"Writing Custom Migration Logic","contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple migration helpers are great for adding fields or dropping tables. However, when you rename fields, merge schemas, or modify non-optional data types (like mapping an "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" to a formatted "},{"code":"String","type":"codeVoice"},{"type":"text","text":"), you need a custom migration."}]},{"type":"paragraph","inlineContent":[{"text":"In this tutorial, we will migrate from ","type":"text"},{"type":"codeVoice","code":"V0_0_1"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"V0_0_2"},{"text":" where we:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Map an old model’s field "},{"type":"codeVoice","code":"randomValue"},{"type":"text","text":" (Int) into a formatted "},{"type":"codeVoice","code":"securityCode"},{"type":"text","text":" (String)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply processing rules during the transfer (clamping negative numbers to zero)."}]}]}]}],"mediaPosition":"trailing"}]}]},{"title":"Custom Persistable","abstract":[{"text":"Make your own types persistable.","type":"text"}],"kind":"callToAction","action":{"overridingTitle":"Get started","type":"reference","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"featuredEyebrow":"Tutorial"}],"references":{"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"kind":"project","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"estimatedTime":"10min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests","title":"Unit Testing Migrations","type":"topic","url":"\/tutorials\/veincore\/migrationunittests","role":"project"},"doc://VeinCore/tutorials/Table-of-Contents/Complex-Migrations":{"type":"topic","abstract":[],"title":"Complex Migrations","kind":"article","url":"\/tutorials\/table-of-contents\/complex-migrations","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations","role":"article"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode","url":"\/tutorials\/veincore\/quick-start-xcode","role":"project","estimatedTime":"5min","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"kind":"project","title":"Quick start Xcode","type":"topic"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"type":"section","url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","title":"Setup","kind":"section","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/Table-of-Contents/Advanced-Queries":{"abstract":[],"kind":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Advanced-Queries","role":"article","title":"Advanced Queries","url":"\/tutorials\/table-of-contents\/advanced-queries","type":"topic"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries":{"url":"\/tutorials\/veincore\/advancedqueries","type":"topic","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries","kind":"project","role":"project","estimatedTime":"5min","title":"Advanced Queries"},"complex-migration-stages-2.swift":{"syntax":"swift","type":"file","content":["import VeinCore","","enum ComplexMigration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ 1. Fetch current models from the V1 database setup","            let oldTests = try context.fetchAll(V0_0_1.Test.self)","","            \/\/ 2. Map old entries to new types individually","            for test in oldTests {","                let sanitizedValue = max(0, test.randomValue)","","                let newTest = V0_0_2.Test(","                    flag: test.flag,","                    someValue: test.someValue,","                    securityCode: \"SEC-\\(sanitizedValue)\"","                )","","                \/\/ Add the new instance and remove the old one.","                \/\/ If a migration has unhandled non-empty tables at the end it will fail.","                try context.insert(newTest)","                try context.delete(test)","            }","        },","        didMigrate: nil","    )","}"],"fileType":"swift","fileName":"Migration.swift","highlights":[],"identifier":"complex-migration-stages-2.swift"},"doc://VeinCore/tutorials/VeinCore/Relationships#Persisting--fetching-a-relationship":{"kind":"section","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Persisting--fetching-a-relationship","title":"Persisting & fetching a relationship","type":"section","url":"\/tutorials\/veincore\/relationships#Persisting--fetching-a-relationship","role":"pseudoSymbol"},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"abstract":[],"kind":"article","title":"Custom Persistable","type":"topic","role":"article","url":"\/tutorials\/table-of-contents\/custom-persistable","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#The-migration-we-are-going-to-test":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","type":"section","role":"pseudoSymbol","title":"The migration we are going to test:","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"kind":"section","url":"\/tutorials\/veincore\/migrationunittests#The-migration-we-are-going-to-test"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"type":"section","title":"ModelContainer & ManagedObjectContext","kind":"section","role":"pseudoSymbol"},"complex-migration-schemas.swift":{"syntax":"swift","type":"file","content":["import VeinCore","","\/\/ Our baseline schema","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Test.self","    ]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var randomValue: Int","","        init(flag: Bool, someValue: String, randomValue: Int) {","            self.flag = flag","            self.someValue = someValue","            self.randomValue = randomValue","        }","    }","}","","\/\/ Our destination schema","enum V0_0_2: VersionedSchema {","    static let version = ModelVersion(0, 0, 2)","    static let models: [any PersistentModel.Type] = [Test.self]","","    @Model","    final class Test {","        var flag: Bool","        var someValue: String","        var securityCode: String \/\/ This replaces the old raw Int","","        init(flag: Bool, someValue: String, securityCode: String) {","            self.flag = flag","            self.someValue = someValue","            self.securityCode = securityCode","        }","    }","}"],"fileType":"swift","fileName":"Schemas.swift","highlights":[],"identifier":"complex-migration-schemas.swift"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","role":"article","title":"Quick start","url":"\/tutorials\/table-of-contents\/quick-start","abstract":[],"kind":"article"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"title":"Relationships","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","kind":"article","url":"\/tutorials\/table-of-contents\/relationships","role":"article"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","url":"\/tutorials\/veincore\/complexmigrations","kind":"project","estimatedTime":"7min","title":"Complex Migrations","role":"project"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","kind":"article","abstract":[],"role":"article","title":"Simple Migrations","url":"\/tutorials\/table-of-contents\/simple-migrations","type":"topic"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","kind":"section","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"title":"Adding a relationship to our model","url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations":{"role":"project","abstract":[{"type":"text","text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions."}],"title":"Simple Database Migrations","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations","type":"topic","kind":"project","estimatedTime":"5min","url":"\/tutorials\/veincore\/simplemigrations"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"type":"topic","abstract":[{"type":"text","text":"Make your own types persistable."}],"estimatedTime":"5min","role":"project","kind":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","url":"\/tutorials\/veincore\/custompersistable","title":"Custom Persistable"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"kind":"section","url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","role":"pseudoSymbol","title":"RawRepresentable","abstract":[{"type":"text","text":"Make your own types persistable."}],"type":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"title":"Create your first Model","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"kind":"section","type":"section"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor":{"type":"section","abstract":[{"type":"text","text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries."}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor","title":"FetchDescriptor and PaginatedFetchDescriptor","role":"pseudoSymbol","url":"\/tutorials\/veincore\/advancedqueries#FetchDescriptor-and-PaginatedFetchDescriptor"},"complex-migration-stages-1.swift":{"identifier":"complex-migration-stages-1.swift","fileType":"swift","highlights":[],"content":["import VeinCore","","enum ComplexMigration: SchemaMigrationPlan {","    static var schemas: [any VersionedSchema.Type] {","        [V0_0_1.self, V0_0_2.self]","    }","","    static var stages: [MigrationStage] {","        [migrateV1toV2]","    }","","    static let migrateV1toV2 = MigrationStage.complex(","        fromVersion: V0_0_1.self,","        toVersion: V0_0_2.self,","        willMigrate: { context in","            \/\/ Custom mapping logic will go here","        },","        didMigrate: nil","    )","}"],"syntax":"swift","fileName":"Migration.swift","type":"file"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"type":"section","title":"Unit Testing","role":"pseudoSymbol","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing"},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"title":"Unit Testing Migrations","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","role":"article","kind":"article","url":"\/tutorials\/table-of-contents\/unit-testing-migrations","type":"topic"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"kind":"section","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","title":"Writing Custom Migration Logic","type":"section","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic","role":"pseudoSymbol"},"doc://