{"kind":"project","metadata":{"categoryPathComponent":"Table-of-Contents","title":"Complex Migrations","role":"project","category":"Vein"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/veincore\/complexmigrations"]}],"sections":[{"title":"Complex Migrations","estimatedTimeInMinutes":7,"kind":"hero","content":[{"type":"paragraph","inlineContent":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}]}],"chapter":"Complex Migrations"},{"kind":"tasks","tasks":[{"anchor":"Writing-Custom-Migration-Logic","title":"Writing Custom Migration Logic","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"Simple migration helpers are great for adding fields or dropping tables. However, when you rename fields, merge schemas, or modify non-optional data types (like mapping an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" to a formatted ","type":"text"},{"code":"String","type":"codeVoice"},{"text":"), you need a custom migration.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this tutorial, we will migrate from "},{"type":"codeVoice","code":"V0_0_1"},{"type":"text","text":" to "},{"type":"codeVoice","code":"V0_0_2"},{"type":"text","text":" where we:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Map an old model’s field ","type":"text"},{"type":"codeVoice","code":"randomValue"},{"text":" (Int) into a formatted ","type":"text"},{"type":"codeVoice","code":"securityCode"},{"text":" (String).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Apply processing rules during the transfer (clamping negative numbers to zero)."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"stepsSection":[{"caption":[],"runtimePreview":null,"code":"complex-migration-schemas.swift","content":[{"inlineContent":[{"type":"text","text":"Define the baseline and destination schemas. Notice that "},{"type":"codeVoice","code":"V0_0_2.Test"},{"type":"text","text":" now requires a non-optional "},{"type":"codeVoice","code":"securityCode"},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"randomValue"},{"type":"text","text":", meaning simple column additions won’t work."}],"type":"paragraph"}],"type":"step","media":null},{"caption":[],"runtimePreview":null,"code":"complex-migration-stages-1.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set up your "},{"type":"codeVoice","code":"SchemaMigrationPlan"},{"type":"text","text":" block, preparing a "},{"type":"codeVoice","code":".complex"},{"type":"text","text":" transition stage from version 1 to version 2."}]}],"type":"step","media":null},{"caption":[],"runtimePreview":null,"code":"complex-migration-stages-2.swift","content":[{"inlineContent":[{"type":"text","text":"Implement the migration logic. Fetch the baseline records, execute your custom business rules, and save the mapped models back to the new schema inside the transition step."}],"type":"paragraph"}],"type":"step","media":null}]}]},{"title":"Custom Persistable","kind":"callToAction","abstract":[{"type":"text","text":"Make your own types persistable."}],"featuredEyebrow":"Tutorial","action":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","type":"reference","overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"isActive":true}}],"hierarchy":{"modules":[{"reference":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","projects":[{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package","sections":[{"reference":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","kind":"task"},{"reference"