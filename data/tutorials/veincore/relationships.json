m-Persistable","title":"Custom Persistable"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"type":"section","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"kind":"section","title":"ModelContainer & ManagedObjectContext","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext"},"relationship-use-1.swift":{"content":["import Foundation","import VeinCore","","func tryRelationships(context: ManagedObjectContext) throws {","    let post = Post(","        title: \"How to use Vein relationships?\",","        content: \"Again, it's pretty easy.\"","    )","    let attachment = Attachment(","        name: \"ExampleFile\",","        fileType: .swift,","        data: Data([UInt8](repeating: 0, count: 1024 * 1024)) \/\/ very real swift file","    )","}"],"highlights":[],"fileType":"swift","fileName":"Post.swift","type":"file","syntax":"swift","identifier":"relationship-use-1.swift"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","role":"pseudoSymbol","type":"section","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"title":"Unit Testing","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing","kind":"section"},"relationship-use-2.swift":{"content":["import Foundation","import VeinCore","","func tryRelationships(context: ManagedObjectContext) throws {","    let post = Post(","        title: \"How to use Vein relationships?\",","        content: \"Again, it's pretty easy.\"","    )","    let attachment = Attachment(","        name: \"ExampleFile\",","        fileType: .swift,","        data: Data([UInt8](repeating: 0, count: 1024 * 1024)) \/\/ very real swift file","    )","","    \/\/ Relationships only work with context.","    try context.insert(post)","    \/\/ Added models get inserted automatically.","    post.attachments.append(attachment)","}"],"type":"file","syntax":"swift","fileName":"Post.swift","identifier":"relationship-use-2.swift","fileType":"swift","highlights":[]},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#The-migration-we-are-going-to-test":{"url":"\/tutorials\/veincore\/migrationunittests#The-migration-we-are-going-to-test","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"title":"The migration we are going to test:","type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","role":"pseudoSymbol"},"relationships-1.swift":{"highlights":[],"fileType":"swift","type":"file","identifier":"relationships-1.swift","fileName":"Post.swift","content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self","    ]","","    @Model","    final class Post {","        var title: String","        var content: String","","        @LazyField","        var attachment: Data?","","        init(title: String, content: String) {","            self.title = title","            self.content = content","        }","    }","","    @Model","    final class Attachment {","        var name: String","        var fileType: FileType","        var sizeMiB: Double","","        @LazyField","        var data: Data?","","        init(name: String, fileType: FileType, data: Data) {","            self.name = name","            self.fileType = fileType","            self.sizeMiB = Double(data.count) \/ 1024 \/ 1024","            self.data = data","        }","","        enum FileType: String, RawRepresentablePersistable {","            case png","            case jpg","            case gif","            case swift","            \/\/ ...","        }","    }","}","","typealias Post = V0_0_1.Post","typealias Attachment = V0_0_1.Attachment","","enum Migration: SchemaMigrationPlan {","    static let schemas: [VersionedSchema.Type] = [","        V0_0_1.self","    ]","","    static let stages: [MigrationStage] = []","}"],"syntax":"swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode":{"kind":"project","role":"project","type":"topic","url":"\/tutorials\/veincore\/quick-start-xcode","title":"Quick start Xcode","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"estimatedTime":"5min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode"},"relationships-2.swift":{"fileName":"Post.swift","fileType":"swift","syntax":"swift","highlights":[],"identifier":"relationships-2.swift","content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self","    ]","","    @Model","    final class Post {","        var title: String","        var content: String","","        @Relationship(","            inverse: \\Attachment.post,","            deleteRule: .cascade","        )","        var attachments: [Attachment]","","        init(title: String, content: String) {","            self.title = title","            self.content = content","        }","    }","","    @Model","    final class Attachment {","        @Relationship","        var post: Post?","","        var name: String","        var fileType: FileType","        var sizeMiB: Double","","        @LazyField","        var data: Data?","","        init(name: String, fileType: FileType, data: Data) {","            self.name = name","            self.fileType = fileType","            self.sizeMiB = Double(data.count) \/ 1024 \/ 1024","            self.data = data","        }","","        enum FileType: String, RawRepresentablePersistable {","            case png","            case jpg","            case gif","            case swift","            \/\/ ...","        }","    }","}","","typealias Post = V0_0_1.Post","typealias Attachment = V0_0_1.Attachment","","enum Migration: SchemaMigrationPlan {","    static let schemas: [VersionedSchema.Type] = [","        V0_0_1.self","    ]","","    static let stages: [MigrationStage] = []","}"],"type":"file"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"type":"section","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","title":"Writing Custom Migration Logic","role":"pseudoSymbol","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic"},"relationship-use-3.swift":{"highlights":[],"fileType":"swift","type":"file","identifier":"relationship-use-3.swift","fileName":"Post.swift","content":["import Foundation","import VeinCore","","func tryRelationships(context: ManagedObjectContext) throws {","    let post = Post(","        title: \"How to use Vein relationships?\",","        content: \"Again, it's pretty easy.\"","    )","    let attachment = Attachment(","        name: \"ExampleFile\",","        fileType: .swift,","        data: Data([UInt8](repeating: 0, count: 1024 * 1024)) \/\/ very real swift file","    )","","    \/\/ Relationships only work with context.","    try context.insert(post)","    \/\/ Added models get inserted automatically.","    post.attachments.append(attachment)","}","","func getSwiftAttachments(of post: Post) -> [Attachment] {","    post.attachments.filter { $0.fileType == .swift }","}"],"syntax":"swift"}}}