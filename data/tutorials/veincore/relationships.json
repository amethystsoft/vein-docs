achment.self","    ]","","    @Model","    final class Post {","        var title: String","        var content: String","","        @Relationship(","            inverse: \\Attachment.post,","            deleteRule: .cascade","        )","        var attachments: [Attachment]","","        init(title: String, content: String) {","            self.title = title","            self.content = content","        }","    }","","    @Model","    final class Attachment {","        @Relationship","        var post: Post?","","        var name: String","        var fileType: FileType","        var sizeMiB: Double","","        @LazyField","        var data: Data?","","        init(name: String, fileType: FileType, data: Data) {","            self.name = name","            self.fileType = fileType","            self.sizeMiB = Double(data.count) \/ 1024 \/ 1024","            self.data = data","        }","","        enum FileType: String, RawRepresentablePersistable {","            case png","            case jpg","            case gif","            case swift","            \/\/ ...","        }","    }","}","","typealias Post = V0_0_1.Post","typealias Attachment = V0_0_1.Attachment","","enum Migration: SchemaMigrationPlan {","    static let schemas: [VersionedSchema.Type] = [","        V0_0_1.self","    ]","","    static let stages: [MigrationStage] = []","}"],"fileName":"Post.swift","type":"file","syntax":"swift","fileType":"swift","highlights":[]},"relationship-use-2.swift":{"content":["import Foundation","import VeinCore","","func tryRelationships(context: ManagedObjectContext) throws {","    let post = Post(","        title: \"How to use Vein relationships?\",","        content: \"Again, it's pretty easy.\"","    )","    let attachment = Attachment(","        name: \"ExampleFile\",","        fileType: .swift,","        data: Data([UInt8](repeating: 0, count: 1024 * 1024)) \/\/ very real swift file","    )","","    \/\/ Relationships only work with context.","    try context.insert(post)","    \/\/ Added models get inserted automatically.","    post.attachments.append(attachment)","}"],"type":"file","identifier":"relationship-use-2.swift","highlights":[],"fileName":"Post.swift","fileType":"swift","syntax":"swift"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"estimatedTime":"10min","url":"\/tutorials\/veincore\/migrationunittests","type":"topic","role":"project","kind":"project","title":"Unit Testing Migrations","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext","url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext","type":"section","kind":"section","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"kind":"section","type":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","title":"Create your first Model"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--Man