InMinutes":3},{"kind":"tasks","tasks":[{"anchor":"Adding-a-relationship-to-our-model","title":"Adding a relationship to our model","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Sometimes it can make sense to move part of your model to a child.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In the following steps we will move the "},{"code":"attachment","type":"codeVoice"},{"type":"text","text":" property to a separate model."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"stepsSection":[{"media":null,"caption":[],"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Create a new Model ","type":"text"},{"code":"Attachment","type":"codeVoice"},{"text":".","type":"text"}]}],"code":"relationships-1.swift","runtimePreview":null},{"runtimePreview":null,"type":"step","code":"relationships-2.swift","content":[{"inlineContent":[{"text":"To connect them, we add the @Relationship macro to both sides.","type":"text"},{"text":" ","type":"text"},{"text":"One side specifies an inverse parameter, now both know the opposing side’s corresponding field name.","type":"text"},{"text":" ","type":"text"},{"text":"We also want attachments to get deleted when a post gets deleted,","type":"text"},{"text":" ","type":"text"},{"text":"that’s defined through the cascade deleteRule.","type":"text"}],"type":"paragraph"}],"caption":[],"media":null}]},{"anchor":"Persisting--fetching-a-relationship","title":"Persisting & fetching a relationship","contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Like any other field, relationships work by setting or getting the parameter they are defined on."}]}],"mediaPosition":"trailing"}],"stepsSection":[{"runtimePreview":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create instances of "},{"type":"codeVoice","code":"Post"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Attachment"},{"type":"text","text":"."}]}],"code":"relationship-use-1.swift","media":null,"type":"step"},{"runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Insert one post into context, then add the attachment."}],"type":"paragraph"}],"code":"relationship-use-2.swift","media":null,"type":"step"},{"runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"text":"To read them, just access the property and do whatever you need.","type":"text"}],"type":"paragraph"}],"code":"relationship-use-3.swift","media":null,"type":"step"}]}]},{"action":{"isActive":true,"overridingTitle":"Get started","type":"reference","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"abstract":[{"type":"text","text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries."}],"featuredEyebrow":"Tutorial","title":"Advanced Queries","kind":"callToAction"}],"metadata":{"categoryPathComponent":"Table-of-Contents","title":"Relationships","category":"Vein","role":"project"},"kind":"project","references":{"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"title":"Writing Custom Migration Logic","kind":"section","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package":{"abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"title":"Quick start Swift Package","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package","estimatedTime":"5min","url":"\/tutorials\/veincore\/quick-start-swift-package","type":"topic","role":"project","kind":"project"},"relationships-2.swift":{"fileName":"Post.swift","identifier":"relationships-2.swift","type":"file","highlights":[],"syntax":"swift","fileType":"swift","content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self,","        Attachment.self","    ]","","    @Model","    final class Post {","        var title: String","        var content: String","","        @Relationship(","            inverse: \\Attachment.post,","            deleteRule: .cascade","        )","        var attachments: [Attachment]","","        init(title: String, content: String) {","            self.title = title","            self.content = content","        }","    }","","    @Model","    final class Attachment {","        @Relationship","        var post: Post?","","        var name: String","        var fileType: FileType","        var sizeMiB: Double","","        @LazyField","        var data: Data?","","        init(name: String, fileType: FileType, data: Data) {","            self.name = name","            self.fileType = fileType","            self.sizeMiB = Double(data.count) \/ 1024 \/ 1024","            self.data = data","        }","","        enum FileType: String, RawRepresentablePersistable {","            case png","            case jpg","            case gif","            case swift","            \/\/ ...","        }","    }","}","","typealias Post = V0_0_1.Post","typealias Attachment = V0_0_1.Attachment","","enum Migration: SchemaMigrationPlan {","    static let schemas: [VersionedSchema.Type] = [","        V0_0_1.self","    ]","","    static let stages: [MigrationStage] = []","}"]},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"role":"pseudoSymbol","title":"Migrating Schemas","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","kind":"sectio