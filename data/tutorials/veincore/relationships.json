  var attachment: Data?","","        init(title: String, content: String) {","            self.title = title","            self.content = content","        }","    }","","    @Model","    final class Attachment {","        var name: String","        var fileType: FileType","        var sizeMiB: Double","","        @LazyField","        var data: Data?","","        init(name: String, fileType: FileType, data: Data) {","            self.name = name","            self.fileType = fileType","            self.sizeMiB = Double(data.count) \/ 1024 \/ 1024","            self.data = data","        }","","        enum FileType: String, RawRepresentablePersistable {","            case png","            case jpg","            case gif","            case swift","            \/\/ ...","        }","    }","}","","typealias Post = V0_0_1.Post","typealias Attachment = V0_0_1.Attachment","","enum Migration: SchemaMigrationPlan {","    static let schemas: [VersionedSchema.Type] = [","        V0_0_1.self","    ]","","    static let stages: [MigrationStage] = []","}"],"type":"file","identifier":"relationships-1.swift","highlights":[],"fileName":"Post.swift","fileType":"swift","syntax":"swift"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","title":"Quick start","url":"\/tutorials\/table-of-contents\/quick-start","type":"topic","kind":"article","abstract":[],"role":"article"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Manual-Persistable":{"kind":"section","type":"section","abstract":[{"text":"Make your own types persistable.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable","role":"pseudoSymbol","url":"\/tutorials\/veincore\/custompersistable#Manual-Persistable","title":"Manual Persistable"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","title":"Custom Persis