e = fileType","            self.sizeMiB = Double(data.count) \/ 1024 \/ 1024","            self.data = data","        }","","        enum FileType: String, RawRepresentablePersistable {","            case png","            case jpg","            case gif","            case swift","            \/\/ ...","        }","    }","}","","typealias Post = V0_0_1.Post","typealias Attachment = V0_0_1.Attachment","","enum Migration: SchemaMigrationPlan {","    static let schemas: [VersionedSchema.Type] = [","        V0_0_1.self","    ]","","    static let stages: [MigrationStage] = []","}"],"fileName":"Post.swift","highlights":[]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","title":"Create your first Model","role":"pseudoSymbol","kind":"section","type":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"role":"pseudoSymbol","type":"section","title":"Setup","url":"\/tutorials\/veincore\/quick-start-xcode#Setup","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","kind":"section"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"kind":"section","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","abstract":[{"type":"text","text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions."}],"role":"pseudoSymbol","title":"Migrating Schemas","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","type":"section"},"relationship-use-3.swift":{"type":"file","identifier":"relationship-use-3.swift","fileType":"swift","syntax":"swift","content":["import Found