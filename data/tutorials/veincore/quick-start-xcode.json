 your app","    )","","    try container.migrate()","","    let post = Post(title: \"How to use Vein?\", content: \"It's very easy.\")","    try container.context.insert(post)","","    post.content = \"What did I tell you?\"","","    try container.context.save()","}"],"syntax":"swift","highlights":[],"fileType":"swift","identifier":"quickstart-use-5.swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext","url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext","type":"section","kind":"section","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"role":"pseudoSymbol"},"quickstart-x-1.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/VeinCore\/quickstart-x-1.png"}],"type":"image","identifier":"quickstart-x-1.png","alt":"The xcode add-package modal."},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","title":"Quick start","url":"\/tutorials\/table-of-contents\/quick-start","type":"topic","kind":"article","abstract":[],"role":"article"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","type":"section","role":"pseudoSymbol","title":"Setup","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#The-migration-we-are-going-to-test":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","title":"The migration we are going to test:","url":"\/tutorials\/veincore\/migrationunittests#The-m