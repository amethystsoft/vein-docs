use-7.swift":{"type":"file","identifier":"quickstart-use-7.swift","fileType":"swift","content":["import VeinCore","","func setupAndUseVein() throws {","    \/\/ When encryption is enabled and you're running on Linux,","    \/\/ you need to tell KeyringAccess your appID too.","    \/\/ If Linux is not one of your targets you can ignore it.","    #if os(Linux)","        Keyring.appIdentifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","","    try container.migrate()","","    let post = Post(title: \"How to use Vein?\", content: \"It's very easy.\")","    try container.context.insert(post)","","    post.content = \"What did I tell you?\"","","    try container.context.save()","","    let posts = try container.context.fetchAll(#Predicate<Post> { post in","        post.title.contains(\"Vein\")","    }) \/\/ gives back [post]","","    try container.context.delete(post)","}"],"highlights":[],"fileName":"VeinExample.swift","syntax":"swift"},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"role":"article","kind":"article","abstract":[],"url":"\/tutorials\/table-of-contents\/custom-persistable","title":"Custom Persistable","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable","type":"topic"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"kind":"section","abstract":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}],"title":"Migrating Schemas","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","url":"\/tutorials\/veincore\/simplemigrations#Migrat