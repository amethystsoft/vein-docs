f, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","","    try container.migrate()","","    let post = Post(title: \"How to use Vein?\", content: \"It's very easy.\")","    try container.context.insert(post)","","    post.content = \"What did I tell you?\"","","    try container.context.save()","","    let posts = try container.context.fetchAll(#Predicate<Post> { post in","        post.title.contains(\"Vein\")","    }) \/\/ gives back [post]","","    try container.context.delete(post)","}"],"identifier":"quickstart-use-7.swift","highlights":[],"fileName":"VeinExample.swift","fileType":"swift","syntax":"swift"},"quickstart-model-3.swift":{"fileName":"Post.swift","type":"file","content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self","    ]","","    @Model","    final class Post {","        var title: String","        var content: String","","        @LazyField","        var attachment: Data?","    }","}"],"syntax":"swift","highlights":[],"fileType":"swift","identifier":"quickstart-model-3.swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"kind":"section","type":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","title":"Create your first Model"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","title":"Custom Persistable","url":"\/tutorials\/veincore\/custompersistable","type":"topic","kind":"project","estimatedTime":"5min","abstract":[{"text":"Make your own t