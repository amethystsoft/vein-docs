del.","type":"text"}]}],"chapter":"Quick start","kind":"hero"},{"tasks":[{"anchor":"Setup","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Get started by installing needed dependencies."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"title":"Setup","stepsSection":[{"media":"quickstart-x-1.png","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"github.com\/amethystsoft\/vein"},{"type":"text","text":" as dependency to your project."},{"type":"text","text":" "},{"type":"text","text":"Choose the latest available version."}]}],"caption":[],"runtimePreview":null,"code":null},{"media":"quickstart-x-2.png","type":"step","content":[{"inlineContent":[{"type":"text","text":"Add VeinCore or VeinSwiftUI as dependency to your App."}],"type":"paragraph"}],"caption":[],"runtimePreview":null,"code":null}]},{"title":"Create your first Model","anchor":"Create-your-first-Model","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Now, let’s build your data model using VeinCore.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia"}],"stepsSection":[{"type":"step","media":null,"runtimePreview":null,"caption":[],"code":"quickstart-model-0.swift","content":[{"inlineContent":[{"text":"To version models, you wrap them in a VersionedSchema.","type":"text"}],"type":"paragraph"}]},{"type":"step","media":null,"runtimePreview":null,"caption":[{"inlineContent":[{"type":"text","text":"You also need to add it to the schemas "},{"code":"models","type":"codeVoice"},{"type":"text","text":" variable."}],"type":"paragraph"}],"code":"quickstart-model-1.swift","content":[{"inlineContent":[{"type":"text","text":"Inside the VersionedSchema, create a new class and add the "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" macro to it."}],"type":"paragraph"}]},{"type":"step","media":null,"runtimePreview":null,"caption":[{"inlineContent":[{"text":"Vein interprets plain, non-static vars as eager loaded fields automatically.","type":"text"}],"type":"paragraph"}],"code":"quickstart-model-2.swift","content":[{"inlineContent":[{"type":"text","text":"Now you start adding your properties."}],"type":"paragraph"}]},{"type":"step","media":null,"runtimePreview":null,"caption":[],"code":"quickstart-model-3.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t want data to be loaded on fetch, but only when its needed, which can make sense for larger data, you can apply "},{"type":"codeVoice","code":"@LazyField"},{"type":"text","text":" to it. LazyFields are always optional."}]}]},{"type":"step","media":null,"runtimePreview":null,"caption":[{"inlineContent":[{"text":"For easier access to it you can create a typealias outside of the ","type":"text"},{"code":"VersionedSchema","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"code":"quickstart-model-4.swift","content":[{"inlineContent":[{"text":"Last, add an initializer you want to use to create a new instance of your model.","type":"text"}],"type":"paragraph"}]},{"type":"step","media":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Just add your VersionedSchema to the schemas array.","type":"text"}]}],"code":"quickstart-model-5.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vein requires a "},{"code":"SchemaMigrationPlan","type":"codeVoice"},{"type":"text","text":", but don’t worry, you don’t have to migrate anything right now."}]}]}]},{"title":"ModelContainer & ManagedObjectContext","anchor":"ModelContainer--ManagedObjectContext","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"How to use the Model?","type":"text"}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"media":null,"content":[{"inlineContent":[{"text":"First you need to create a model container.","type":"text"},{"text":" ","type":"text"},{"text":"Vein encrypts on the DB level by default.","type":"text"},{"text":" ","type":"text"},{"text":"If you don’t want that, you can disable it via the encryptionEnabled parameter.","type":"text"}],"type":"paragraph"}],"caption":[],"code":"quickstart-use-1.swift","runtimePreview":null,"type":"step"},{"media":null,"content":[{"inlineContent":[{"type":"text","text":"Tell the container to migrate to the current schema if needed."}],"type":"paragraph"}],"caption":[],"code":"quickstart-use-2.swift","runtimePreview":null,"type":"step"},{"media":null,"content":[{"inlineContent":[{"type":"text","text":"Create a post and add it to the context."}],"type":"paragraph"}],"caption":[],"code":"quickstart-use-3.swift","runtimePreview":null,"type":"step"},{"media":null,"content":[{"inlineContent":[{"text":"To update a field, just set it to something new via the swift property.","type":"text"}],"type":"paragraph"}],"caption":[],"code":"quickstart-use-4.swift","runtimePreview":null,"type":"step"},{"media":null,"content":[{"inlineContent":[{"text":"To persist changes, you need to call ","type":"text"},{"type":"codeVoice","code":"save()"},{"text":" on the context.","type":"text"}],"type":"paragraph"}],"caption":[{"inlineContent":[{"text":"Until then all changes are only tracked in memory.","type":"text"}],"type":"paragraph"}],"code":"quickstart-use-5.swift","runtimePreview":null,"type":"step"},{"media":null,"content":[{"inlineContent":[{"type":"text","text":"To retrieve models from the context, persisted and unpersisted, you can use fetchAll on the context and filter using a Predicate."}],"type":"paragraph"}],"caption":[],"code":"quickstart-use-6.swift","runtimePreview":null,"type":"step"},{"media":null,"content":[{"inlineContent":[{"text":"Last but not least, to delete a model, just call ","type":"text"},{"type":"codeVoice","code":"context.delete()"},{"text":" with it.","type":"text"}],"type":"paragraph"}],"caption":[],"code":"quickstart-use-7.swift","runtimePreview":null,"type":"step"}]}],"kind":"tasks"},{"title":"Relationships","kind":"callToAction","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"featuredEyebrow":"Tutorial","action":{"isActive":true,"type":"reference","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships","overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}]}}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/veincore\/quick-start-xcode"]}],"references":{"doc://VeinCore/tutorials/VeinCore/Relationships":{"title":"Relationships","estimatedTime":"3min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"role":"project","type":"topic","kind":"project","url":"\/tutorials\/veincore\/relationships"},"doc://VeinCore/tutorials/VeinCore/Relationships#Persisting--fetching-a-relationship":{"type":"section","title":"Persisting & fetching a relationship","url":"\/tutorials\/veincore\/relationships#Persisting--fetching-a-relationship","role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Persisting--fetching-a-relationship","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"kind":"section"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"title":"Complex Migrations","type":"topic","url":"\/tutorials\/veincore\/complexmigrations","role":"project","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","kind":"project","estimatedTime":"7min"},"quickstart-use-1.swift":{"type":"file","fileType":"swift","content":["import VeinCore","","func setupAndUseVein() throws {","    \/\/ When encryption is enabled and you're running on Linux,","    \/\/ you need to tell KeyringAccess your appID too.","    \/\/ If Linux is not one of your targets you can ignore it.","    #if os(Linux)","        Keyring.appIdentifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","}"],"identifier":"quickstart-use-1.swift","highlights":[],"fileName":"VeinExample.swift","syntax":"swift"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"abstract":[{"text":"Make your own types persistable.","type":"text"}],"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","title":"RawRepresentable"},"quickstart-model-3.swift":{"fileType":"swift","fileName":"Post.swift","identifier":"quickstart-model-3.swift","syntax":"swift","content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self","    ]","","    @Model","    final class Post {","        var title: String","        var content: String","","        @LazyField","        var attachment: Data?","    }","}"],"type":"file","highlights":[]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","title":"Setup","url":"\/tutorials\/veincore\/quick-start-xcode#Setup","role":"pseudoSymbol","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"type":"section","kind":"section"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor","kind":"section","role":"pseudoSymbol","type":"section","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"url":"\/tutorials\/veincore\/advancedqueries#FetchDescriptor-and-PaginatedFetchDescriptor","title":"FetchDescriptor and PaginatedFetchDescriptor"},"doc://VeinCore/tutorials/Table-of-Contents/Advanced-Queries":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Advanced-Queries","url":"\/tutorials\/table-of-contents\/advanced-queries","role":"article","type":"topic","abstract":[],"kind":"article","title":"Advanced Queries"},"quickstart-model-2.swift":{"fileType":"swift","fileName":"Post.swift","type":"file","highlights":[],"syntax":"swift","identifier":"quickstart-model-2.swift","content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self","    ]","","    @Model","    final class Post {","        var title: String","        var content: String","    }","}"]},"quickstart-use-5.swift":{"type":"file","fileType":"swift","fileName":"VeinExample.swift","syntax":"swift","content":["import VeinCore","","func setupAndUseVein() throws {","    \/\/ When encryption is enabled and you're running on Linux,","    \/\/ you need to tell KeyringAccess your appID too.","    \/\/ If Linux is not one of your targets you can ignore it.","    #if os(Linux)","        Keyring.appIdentifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","","    try container.migrate()","","    let post = Post(title: \"How to use Vein?\", content: \"It's very easy.\")","    try container.context.insert(post)","","    post.content = \"What did I tell you?\"","","    try container.context.save()","}"],"highlights":[],"identifier":"quickstart-use-5.swift"},"quickstart-x-1.png":{"identifier":"quickstart-x-1.png","alt":"The xcode add-package modal.","variants":[{"traits":["1x","light"],"url":"\/images\/VeinCore\/quickstart-x-1.png"}],"type":"image"},"quickstart-model-0.swift":{"content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","","    ]","}"],"fileName":"Post.swift","type":"file","identifier":"quickstart-model-0.swift","highlights":[],"fileType":"swift","syntax":"swift"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#The-migration-we-are-going-to-test":{"url":"\/tutorials\/veincore\/migrationunittests#The-migration-we-are-going-to-test","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"title":"The migration we are going to test:","type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package":{"abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"url":"\/tutorials\/veincore\/quick-start-swift-package","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package","title":"Quick start Swift Package","kind":"project","role":"project","type":"topic","estimatedTime":"5min"},"quickstart-use-7.swift":{"highlights":[],"content":["import VeinCore","","func setupAndUseVein() throws {","    \/\/ When encryption is enabled and you're running on Linux,","    \/\/ you need to tell KeyringAccess your appID too.","    \/\/ If Linux is not one of your targets you can ignore it.","    #if os(Linux)","        Keyring.appIdentifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","","    try container.migrate()","","    let post = Post(title: \"How to use Vein?\", content: \"It's very easy.\")","    try container.context.insert(post)","","    post.content = \"What did I tell you?\"","","    try container.context.save()","","    let posts = try container.context.fetchAll(#Predicate<Post> { post in","        post.title.contains(\"Vein\")","    }) \/\/ gives back [post]","","    try container.context.delete(post)","}"],"type":"file","syntax":"swift","identifier":"quickstart-use-7.swift","fileName":"VeinExample.swift","fileType":"swift"},"quickstart-use-2.swift":{"fileType":"swift","identifier":"quickstart-use-2.swift","highlights":[],"fileName":"VeinExample.swift","content":["import VeinCore","","func setupAndUseVein() throws {","    \/\/ When encryption is enabled and you're running on Linux,","    \/\/ you need to tell KeyringAccess your appID too.","    \/\/ If Linux is not one of your targets you can ignore it.","    #if os(Linux)","        Keyring.appIdentifier.withLock { identifier in","            identifier = \"com.example.app\"","        }","    #endif","","    let container = try ModelContainer(","        V0_0_1.self, \/\/ Your VersionedSchema","        migration: Migration.self, \/\/ Your SchemaMigrationPlan","        at: \"path\/to\/db.sqlite3\", \/\/ or nil for in memory","        appID: \"com.example.app\" \/\/ The id of your app","    )","","    try container.migrate()","}"],"type":"file","syntax":"swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"type":"section","role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","title":"Create your first Model","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"kind":"section"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"type":"topic","url":"\/tutorials\/veincore\/migrationunittests","kind":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests","title":"Unit Testing Migrations","role":"project","estimatedTime":"10min","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}]},"doc://VeinCore/tutorials/Table-of-Contents/Complex-Migrations":{"role":"article","type":"topic","title":"Complex Migrations","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations","abstract":[],"url":"\/tutorials\/table-of-contents\/complex-migrations","kind":"article"},"doc://VeinCore/tutorials/Table-of-Contents":{"kind":"overview","title":"Meet Vein","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","type":"topic","url":"\/tutorials\/table-of-contents","abstract":[{"text":"Database for apps made easy.","type":"text"}],"role":"overview"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Codable":{"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Codable","type":"section","url":"\/tutorials\/veincore\/custompersistable#Codable","role":"pseudoSymbol","title":"Codable","abstract":[{"text":"Make your own types persistable.","type":"text"}]},"quickstart-x-2.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/VeinCore\/quickstart-x-2.png"}],"alt":"The xcode add-package modal with version.","type":"image","identifier":"quickstart-x-2.png"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","role":"pseudoSymbol","title":"Adding a relationship to our model","kind":"section","type":"section","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"type":"section","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"kind":"section","title":"ModelContainer & ManagedObjectContext","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"abstract":[],"type":"topic","url":"\/tutorials\/table-of-contents\/simple-migrations","kind":"article","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","title":"Simple Migrations"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","role":"pseudoSymbol","type":"section","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"title":"Unit Testing","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing","kind":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":