st.self","    ]","","    @Model","    final class Post {","","    }","}"],"identifier":"quickstart-model-1.swift"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"role":"pseudoSymbol","title":"Migrating Schemas","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","abstract":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}],"type":"section"},"quickstart-model-5.swift":{"fileName":"Post.swift","syntax":"swift","content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self","    ]","","    @Model","    final class Post {","        var title: String","        var content: String","","        @LazyField","        var attachment: Data?","","        init(title: String, content: String) {","            self.title = title","            self.content = content","        }","    }","}","","typealias Post = V0_0_1.Post","","enum Migration: SchemaMigrationPlan {","    static let schemas: [VersionedSchema.Type] = [","        V0_0_1.self","    ]","","    static let stages: [MigrationStage] = []","}"],"identifier":"quickstart-model-5.swift","type":"file","fileType":"swift","highlights":[]},"quickstart-model-2.swift":{"fileType":"swift","content":["import Foundation","import VeinCore","","enum V0_0_1: VersionedSchema {","    static let version = ModelVersion(0, 0, 1)","    static let models: [any PersistentModel.Type] = [","        Post.self","    ]","","    @Model","    final class Post {","        var title: String","        var content: String","    }","}"],"fileName":"Post.swift","type":"file","syntax":"swift","identifier":"quickstart-model-2.swift","highlights":[]},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"title":"Writing Custom Migration Logic","kind":"section","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"title":"Unit Testing Migrations","url":"\/tutorials\/table-of-contents\/unit-testing-migrations","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","kind":"article"},"doc://VeinCore/tutorials/VeinCore/Relationships#Persisting--fetching-a-relationship":{"kind":"section","url":"\/tutorials\/veincore\/relationships#Persisting--fetching-a-relationship","title":"Persisting & fetching a relationship","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Persisting--fetching-a-relationship","role":"pseudoSymbol","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"type":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"kind":"section","title":"ModelContainer & ManagedObjectContext","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"title":"Quick start","url":"\/tutorials\/table-of-contents\/quick-start","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","kind":"article"},"doc://Ve