Test.swift","identifier":"unit-test-migrations-f-0.swift","fileType":"swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct FullChain {","    @Test","    func fullChainVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","    }","}"],"syntax":"swift"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"kind":"article","title":"Simple Migrations","role":"article","url":"\/tutorials\/table-of-contents\/simple-migrations","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","abstract":[]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Codable":{"url":"\/tutorials\/veincore\/custompersistable#Codable","kind":"section","abstract":[{"type":"text","text":"Make your own types persistable."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Codable","type":"section","title":"Codable","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"kind":"section","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext","type":"section","title":"ModelContainer & ManagedObjectContext","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries":{"title":"Advanced Queries","url":"\/tutorials\/veincore\/advancedqueries","estimatedTime":"5min","role":"project","type":"topic","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries","kind":"project"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"title":"Relationships","url":"\/tutorials\/table-of-contents\/relationships","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","kind":"article"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"title":"RawRepresentable","url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","role":"pseudoSymbol","type":"section","abstract":[{"type":"text","text":"Make your own types persistable."}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","kind":"section"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"title":"Quick start","url":"\/tutorials\/table-of-contents\/quick-start","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","kind":"article"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"role":"pseudoSymbol","title":"Migrating Schemas","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","abstract":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}],"type":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"kind":"section","title":"Setup","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"unit-test-migrations-schemas.swift":{"content":["import Foundation","import VeinCore","","fileprivate enum Version1: VersionedSchema {","    static let version = ModelVersion(1, 0, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        init(username: String) { self.username = username }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        init(bio: String) { self.bio = bio }","    }","}","","fileprivate enum Version2: VersionedSchema {","    static let version = ModelVersion(1, 1, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        \/\/ Added field","        @Field var email: String?","        init(username: String, email: String?) {","            self.username = username","            self.email = email","        }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        init(bio: String) { self.bio = bio }","    }","}","","fileprivate enum Version3: VersionedSchema {","    static let version = ModelVersion(1, 2, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self,","        Post.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        @Field var email: String?","        init(username: String, email: String?) {","            self.username = username","            self.email = email","        }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        \/\/ added field","        @Field var internalID: String","        init(bio: String, internalID: String) {","            self.bio = bio","            self.internalID = internalID","        }","    }","    ","    @Model","    final class Post {","        @Field var content: String","        init(content: String) { self.content = content }","    }","}","","fileprivate enum MigrationPlan: SchemaMigrationPlan {","    static var schemas: [any Vein.VersionedSchema.Type] {[","        Version1.self,","        Version2.self,","        Version3.self","    ]}","    ","    static var stages: [Vein.MigrationStage] {[","        v1ToV2,","        v2ToV3,","    ]}","    ","    static let v1ToV2 = Vein.MigrationStage.complex(","        fromVersion: Version1.self,","        toVersion: Version2.self,","        willMigrate: { context in","            try Version1.User.fieldsAddedMigration(to: Version2.User.self, on: context)","            try Version1.Profile.unchangedMigration(to: Version2.Profile.self, on: context)","        },","        didMigrate: nil","    )","    ","    static let v2ToV3 = Vein.MigrationStage.complex(","        fromVersion: Version2.self,","        toVersion: Version3.self,","        willMigrate: { context in","            \/\/ Basic migrations","            try Version2.User.unchangedMigration(to: Version3.User.self, on: context)","            ","            \/\/ Logic migration for Profile","            let oldProfiles = try context.fetchAll(Version2.Profile.self)","            for old in oldProfiles {","                let new = Version3.Profile(","                    bio: old.bio,","                    internalID: \"ID-\\(Int.random(in: 1000...9999))\"","                )","                try context.insert(new)","                try context.delete(old)","            }","        },","        didMigrate: nil","    )","}"],"highlights":[],"syntax":"swift","fileName":"Schemas.swift","identifier":"unit-test-migrations-schemas.swift","fileType":"swift","type":"file"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Manual-Persistable":{"role":"pseudoSymbol","abstract":[{"type":"text","text":"Make your own types persistable."}],"type":"section","url":"\/tutorials\/veincore\/custompersistable#Manual-Persistable","title":"Manual Persistable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable","kind":"section"},"doc://VeinCore/tutorials/Table-of-Contents":{"kind":"overview","title":"Meet Vein","role":"overview","url":"\/tutorials\/table-of-contents","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","abstract":[{"text":"Database for apps made easy.","type":"text"}]},"unit-test-migrations-f-2.swift":{"fileName":"FullChainTest.swift","syntax":"swift","identifier":"unit-test-migrations-f-2.swift","fileType":"swift","type":"file","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct FullChain {","    @Test","    func fullChainVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.testCompleteChain(","            initialData: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            },","            validations: [","                Version3.version: { context in","                    let users = try context","                        .fetchAll(Version3.User.self)","                    #expect(users.count == 1)","                    ","                    let profiles = try context","                        .fetchAll(Version3.Profile.self)","                    #expect(profiles.count == 1)","                    ","                    if let profile = profiles.first {","                        #expect(profile.bio == bio)","                        #expect(profile.internalID.hasPrefix(\"ID-\"))","                        if let id = Int(profile.internalID.dropFirst(3)) {","                            #expect((1000...9999).contains(id))","                        } else {","                            Issue.record(\"Internal ID should be a number after `ID-` prefix\")","                        }","                    }","                }","            ]","        )","    }","}"],"highlights":[]},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"estimatedTime":"7min","kind":"project","url":"\/tutorials\/veincore\/complexmigrations","title":"Complex Migrations","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","role":"project","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"type":"topic"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","title":"Unit Testing","role":"pseudoSymbol","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing","kind":"section"}}}