ategory":"Vein"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/veincore\/migrationunittests"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Create-your-first-Model":{"type":"section","kind":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"title":"Create your first Model","url":"\/tutorials\/veincore\/quick-start-swift-package#Create-your-first-Model","role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Create-your-first-Model"},"unit-test-migrations-1.swift":{"identifier":"unit-test-migrations-1.swift","fileName":"StepByStepTest.swift","highlights":[],"syntax":"swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","    }","}"],"type":"file","fileType":"swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package":{"abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"title":"Quick start Swift Package","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package","estimatedTime":"5min","url":"\/tutorials\/veincore\/quick-start-swift-package","type":"topic","role":"project","kind":"project"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"kind":"section","title":"ModelContainer & ManagedObjectContext","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","url":"\/tutorials\/veincore\/custompersistable","title":"Custom Persistable","abstract":[{"type":"text","text":"Make your own types persistable."}],"role":"project","type":"topic","estimatedTime":"5min","kind":"project"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"title":"Writing Custom Migration Logic","kind":"section","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}],"role":"pseudoSymbol"},"unit-test-migrations-2.swift":{"type":"file","identifier":"unit-test-migrations-2.swift","syntax":"swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version2.self,","            with: { context in","                let users = try context","                    .fetchAll(Version2.User.self)","                #expect(users.count == 1)","                ","                if let user = users.first {","                    #expect(user.username == username)","                    #expect(user.email == nil)","                    ","                    user.email = email","                }","                ","                let profiles = try context","                    .fetchAll(Version2.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                }","                ","                try context.save()","            }","        )","    }","}"],"fileName":"StepByStepTest.swift","fileType":"swift","highlights":[]},"doc://VeinCore/tutorials/Table-of-Contents/Advanced-Queries":{"title":"Advanced Queries","url":"\/tutorials\/table-of-contents\/advanced-queries","role":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Advanced-Queries","kind":"article"},"unit-test-migrations-3.swift":{"type":"file","highlights":[],"identifier":"unit-test-migrations-3.swift","fileName":"StepByStepTest.swift","fileType":"swift","syntax":"swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version2.self,","            with: { context in","                let users = try context","                    .fetchAll(Version2.User.self)","                #expect(users.count == 1)","                ","                if let user = users.first {","                    #expect(user.username == username)","                    #expect(user.email == nil)","                    ","                    user.email = email","                }","                ","                let profiles = try context","                    .fetchAll(Version2.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                }","                ","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version3.self,","            with: { context in","                let users = try context","                    .fetchAll(Version3.User.self)","                #expect(users.count == 1)","                ","                let profiles = try context","                    .fetchAll(Version3.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                    #expect(profile.internalID.hasPrefix(\"ID-\"))","                    if let id = Int(profile.internalID.dropFirst(3)) {","                        #expect((1000...9999).contains(id))","                    } else {","                        Issue.record(\"Internal ID should be a number after `ID-` prefix\")","                    }","                }","            }","        )","    }","}"]},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","kind":"section","role":"pseudoSymbol","title":"Adding a relationship to our model","abstract":[{"type":"text","text":"Use relationships with VeinCore."}]},"unit-test-migrations-f-1.swift":{"fileName":"FullChainTest.swift","type":"file","syntax":"swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct FullChain {","    @Test","    func fullChainVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.testCompleteChain(","            initialData: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            },","            validations: [","                ","            ]","        )","    }","}"],"highlights":[],"identifier":"unit-test-migrations-f-1.swift","fileType":"swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"type":"section"