asant, Vein comes with a testing helper.","type":"text"}],"type":"paragraph"}],"chapter":"Unit Testing Migrations","estimatedTimeInMinutes":10,"kind":"hero","title":"Unit Testing Migrations"},{"tasks":[{"anchor":"The-migration-we-are-going-to-test","title":"The migration we are going to test:","contentSection":[{"content":[{"inlineContent":[{"text":"This is a shortened part of one of Vein’s unit tests.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"code":"unit-test-migrations-schemas.swift","content":[{"inlineContent":[{"type":"text","text":"You would just use your own existing models and migrations."}],"type":"paragraph"}],"type":"step","caption":[],"media":null,"runtimePreview":null}]},{"anchor":"Unit-Testing","title":"Unit Testing","contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"There are two builtin ways to test your migrations."},{"type":"text","text":" "},{"type":"text","text":"First we’re going to cover the step by step approach and then the full chain one."},{"type":"text","text":" "},{"type":"text","text":"You can choose whatever you like more."}],"type":"paragraph"}],"mediaPosition":"trailing"}],"stepsSection":[{"type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"First, create a ","type":"text"},{"code":"MigrationTester","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"VeinTesting","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It will validate the protocol requirements of ","type":"text"},{"code":"VersionedSchema","type":"codeVoice"},{"text":".","type":"text"}]}],"caption":[],"code":"unit-test-migrations-0.swift"},{"type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now seed the database with arbitrary contents you want to migrate."},{"type":"text","text":" "},{"type":"text","text":"We recommend starting at the first version to cover everything."}]}],"caption":[],"code":"unit-test-migrations-1.swift"},{"type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Now migrate to the next version and check the migration results.","type":"text"}]}],"caption":[],"code":"unit-test-migrations-2.swift"},{"type":"step","media":null,"runtimePreview":null,"content":[{"inlineContent":[{"text":"Repeat for any further versions until you’re done.","type":"text"}],"type":"paragraph"}],"caption":[],"code":"unit-test-migrations-3.swift"}]},{"anchor":"Unit-Testing-full-migration-chain","title":"Unit Testing full migration chain","contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The other option is migrating the whole chain and checking where you want to."}]}],"mediaPosition":"trailing"}],"stepsSection":[{"caption":[],"media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"First, again create a ","type":"text"},{"type":"codeVoice","code":"MigrationTester"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"VeinTesting"},{"text":".","type":"text"}]}],"runtimePreview":null,"code":"unit-test-migrations-f-0.swift"},{"caption":[],"media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Just like before, seed the database with arbitrary contents you want to migrate.","type":"text"}]}],"runtimePreview":null,"code":"unit-test-migrations-f-1.swift"},{"caption":[],"media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"For every version you want to check after migrating, add the version with a validation block to the validations dictionary.","type":"text"}]}],"runtimePreview":null,"code":"unit-test-migrations-f-2.swift"}]}],"kind":"tasks"}],"references":{"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"kind":"section","abstract":[{"text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions.","type":"text"}],"title":"Migrating Schemas","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","type":"section","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"type":"section","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","title":"Setup","kind":"section","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}]},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"estimatedTime":"7min","kind":"project","title":"Complex Migrations","url":"\/tutorials\/veincore\/complexmigrations","type":"topic","role":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","abstract":[{"type":"text","text":"Handle structural database transformations by fetching existing models and inserting new ones."}]},"doc://VeinCore/tutorials/VeinCore/Relationships#Persisting--fetching-a-relationship":{"title":"Persisting & fetching a relationship","url":"\/tutorials\/veincore\/relationships#Persisting--fetching-a-relationship","role":"pseudoSymbol","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Persisting--fetching-a-relationship","type":"section"},"doc://VeinCore/tutorials/VeinCore/Relationships":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships","url":"\/tutorials\/veincore\/relationships","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"title":"Relationships","type":"topic","estimatedTime":"3min","kind":"project","role":"project"},"unit-test-migrations-schemas.swift":{"syntax":"swift","content":["import Foundation","import VeinCore","","fileprivate enum Version1: VersionedSchema {","    static let version = ModelVersion(1, 0, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        init(username: String) { self.username = username }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        init(bio: String) { self.bio = bio }","    }","}","","fileprivate enum Version2: VersionedSchema {","    static let version = ModelVersion(1, 1, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        \/\/ Added field","        @Field var email: String?","        init(username: String, email: String?) {","            self.username = username","            self.email = email","        }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        init(bio: String) { self.bio = bio }","    }","}","","fileprivate enum Version3: VersionedSchema {","    static let version = ModelVersion(1, 2, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self,","        Post.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        @Field var email: String?","        init(username: String, email: String?) {","            self.username = username","            self.email = email","        }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        \/\/ added field","        @Field var internalID: String","        init(bio: String, internalID: String) {","            self.bio = bio","            self.internalID = internalID","        }","    }","    ","    @Model","    final class Post {","        @Field var content: String","        init(content: String) { self.content = content }","    }","}","","fileprivate enum MigrationPlan: SchemaMigrationPlan {","    static var schemas: [any Vein.VersionedSchema.Type] {[","        Version1.self,","        Version2.self,","        Version3.self","    ]}","    ","    static var stages: [Vein.MigrationStage] {[","        v1ToV2,","        v2ToV3,","    ]}","    ","    static let v1ToV2 = Vein.MigrationStage.complex(","        fromVersion: Version1.self,","        toVersion: Version2.self,","        willMigrate: { context in","            try Version1.User.fieldsAddedMigration(to: Version2.User.self, on: context)","            try Version1.Profile.unchangedMigration(to: Version2.Profile.self, on: context)","        },","        didMigrate: nil","    )","    ","    static let v2ToV3 = Vein.MigrationStage.complex(","        fromVersion: Version2.self,","        toVersion: Version3.self,","        willMigrate: { context in","            \/\/ Basic migrations","            try Version2.User.unchangedMigration(to: Version3.User.self, on: context)","            ","            \/\/ Logic migration for Profile","            let oldProfiles = try context.fetchAll(Version2.Profile.self)","            for old in oldProfiles {","                let new = Version3.Profile(","                    bio: old.bio,","                    internalID: \"ID-\\(Int.random(in: 1000...9999))\"","                )","                try context.insert(new)","                try context.delete(old)","            }","        },","        didMigrate: nil","    )","}"],"type":"file","fileType":"swift","identifier":"unit-test-migrations-schemas.swift","highlights":[],"fileName":"Schemas.swift"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","abstract":[{"type":"text","text":"Make your own types persistable."}],"title":"RawRepresentable","role":"pseudoSymbol","type":"section","kind":"section"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"title":"Unit Testing Migrations","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"kind":"project","role":"project","url":"\/tutorials\/veincore\/migrationunittests","estimatedTime":"10min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests","type":"topic"},"doc://VeinCore/tutorials/Table-of-Contents":{"type":"topic","title":"Meet Vein","kind":"overview","abstract":[{"text":"Database for apps made easy.","type":"text"}],"role":"overview","url":"\/tutorials\/table-of-contents","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"type":"topic","url":"\/tutorials\/table-of-contents\/quick-start","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","kind":"article","role":"article","title":"Quick start"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"title":"Create your first Model","role":"pseudoSymbol","type":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","kind":"section"},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"role":"article","kind":"article","abstract":[],"url":"\/tutorials\/table-of-contents\/custom-persistable","title":"Custom Persistable","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable","type":"topic"},"unit-test-migrations-1.swift":{"identifier":"unit-test-migrations-1.swift","fileName":"StepByStepTest.swift","highlights":[],"type":"file","fileType":"swift","syntax":"swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","    }","}"]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Manual-Persistable":{"abstract":[{"text":"Make your own types persistable.","type":"text"}],"kind":"section","title":"Manual Persistable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable","url":"\/tutorials\/veincore\/custompersistable#Manual-Persistable","type":"section","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Relationships#Adding-a-relationship-to-our-model":{"role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Adding-a-relationship-to-our-model","type":"section","kind":"section","url":"\/tutorials\/veincore\/relationships#Adding-a-relationship-to-our-model","title":"Adding a relationship to our model","abstract":[{"type":"text","text":"Use relationships with VeinCore."}]},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","title":"Setup","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#Setup","kind":"section","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"unit-test-migrations-f-0.swift":{"syntax":"swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct FullChain {","    @Test","    func fullChainVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","    }","}"],"type":"file","fileType":"swift","identifier":"unit-test-migrations-f-0.swift","highlights":[],"fileName":"FullChainTest.swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode":{"url":"\/tutorials\/veincore\/quick-start-xcode","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"role":"project","type":"topic","kind":"project","title":"Quick start Xcode","estimatedTime":"5min"},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","role":"article","kind":"article","title":"Unit Testing Migrations","url":"\/tutorials\/table-of-contents\/unit-testing-migrations"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package":{"title":"Quick start Swift Package","estimatedTime":"5min","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"type":"topic","url":"\/tutorials\/veincore\/quick-start-swift-package","kind":"project","role":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","kind":"article","title":"Simple Migrations","role":"article","url":"\/tutorials\/table-of-contents\/simple-migrations","abstract":[],"type":"topic"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"kind":"article","role":"article","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","title":"Relationships","url":"\/tutorials\/table-of-contents\/relationships","abstract":[]},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing-full-migration-chain":{"role":"pseudoSymbol","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing-full-migration-chain","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"type":"section","title":"Unit Testing full migration chain","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain"},"unit-test-migrations-3.swift":{"identifier":"unit-test-migrations-3.swift","fileName":"StepByStepTest.swift","highlights":[],"syntax":"swift","type":"file","fileType":"swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version2.self,","            with: { context in","                let users = try context","                    .fetchAll(Version2.User.self)","                #expect(users.count == 1)","                ","                if let user = users.first {","                    #expect(user.username == username)","                    #expect(user.email == nil)","                    ","                    user.email = email","                }","                ","                let profiles = try context","                    .fetchAll(Version2.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                }","                ","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version3.self,","            with: { context in","                let users = try context","                    .fetchAll(Version3.User.self)","                #expect(users.count == 1)","                ","                let profiles = try context","                    .fetchAll(Version3.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                    #expect(profile.internalID.hasPrefix(\"ID-\"))","                    if let id = Int(profile.internalID.dropFirst(3)) {","                        #expect((1000...9999).contains(id))","                    } else {","                        Issue.record(\"Internal ID should be a number after `ID-` prefix\")","                    }","                }","            }","        )","    }","}"]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"title":"Custom Persistable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","abstract":[{"type":"text","text":"Make your own types persistable."}],"url":"\/tutorials\/veincore\/custompersistable","kind":"project","estimatedTime":"5min","type":"topic","role":"project"