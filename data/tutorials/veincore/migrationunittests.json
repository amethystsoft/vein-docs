ontents/Quick-start":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","title":"Quick start","url":"\/tutorials\/table-of-contents\/quick-start","type":"topic","kind":"article","abstract":[],"role":"article"},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable","role":"article","url":"\/tutorials\/table-of-contents\/custom-persistable","title":"Custom Persistable"},"doc://VeinCore/tutorials/Table-of-Contents":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","title":"Meet Vein","url":"\/tutorials\/table-of-contents","type":"topic","kind":"overview","abstract":[{"text":"Database for apps made easy.","type":"text"}],"role":"overview"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode":{"estimatedTime":"5min","url":"\/tutorials\/veincore\/quick-start-xcode","type":"topic","role":"project","kind":"project","title":"Quick start Xcode","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"unit-test-migrations-3.swift":{"type":"file","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version2.self,","            with: { context in","                let users = try context","                    .fetchAll(Version2.User.self)","                #expect(users.count == 1)","                ","                if let user = users.first {","                    #expect(user.username == username)","                    #expect(user.email == nil)","                    ","                    user.email = email","                }","                ","                let profiles = try context","                    .fetchAll(Version2.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                }","                ","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version3.self,","            with: { context in","                let users = try context","                    .fetchAll(Version3.User.self)","                #expect(users.count == 1)","                ","                let profiles = try context","                    .fetchAll(Version3.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                    #expect(profile.internalID.hasPrefix(\"ID-\"))","                    if let id = Int(profile.internalID.dropFirst(3)) {","                        #expect((1000...9999).contains(id))","                    } else {","                        Issue.record(\"Internal ID should be a number after `ID-` prefix\")","                    }","                }","            }","        )","    }","}"],"identifier":"unit-test-migrations-3.swift","highlights":[],"fileType":"swift","fileName":"StepByStepTest.swift","syntax":"swift"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","role":"article","url":"\/tutorials\/table-of-contents\/simple-migrations","title":"Simple Migrations"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","title":"Relationships","url":"\/tutorials\/table-of-contents\/relationships","type":"topic","kind":"article","abstract":[],"role":"article"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#ModelContainer--ManagedObjectContext","title":"ModelContainer & ManagedObjectContext","url":"\/tutorials\/veincore\/quick-start-swift-package#ModelContainer--ManagedObjectContext","type":"section","kind":"section","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","title":"Custom Persistable","url":"\/tutorials\/veincore\/custompersistable","type":"topic","kind":"project","estimatedTime":"5min","abstract":[{"text":"Make your own types persistable.","type":"text"}],"role":"project"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing-full-migration-chain":{"url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing-full-migration-chain","type":"section","role":"pseudoSymbol","title":"Unit Testing full migration chain","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}]},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","role":"article","url":"\/tutorials\/table-of-contents\/unit-testing-migrations","title":"Unit Testing Migrations"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","type":"section","role":"pseudoSymbol","title":"Setup","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}]},"doc://VeinCore/tutorials/Table-of-Contents/Advanced-Queries":{"kind":"article","type":"topic","abstract":[],"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Advanced-Queries","role":"article","url":"\/tutorials\/table-of-contents\/advanced-queries","title":"Advanced Queries"}}}