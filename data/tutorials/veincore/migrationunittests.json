.swift","runtimePreview":null,"content":[{"inlineContent":[{"text":"Now seed the database with arbitrary contents you want to migrate.","type":"text"},{"text":" ","type":"text"},{"text":"We recommend starting at the first version to cover everything.","type":"text"}],"type":"paragraph"}]},{"type":"step","media":null,"caption":[],"code":"unit-test-migrations-2.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Now migrate to the next version and check the migration results.","type":"text"}]}]},{"type":"step","media":null,"caption":[],"code":"unit-test-migrations-3.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeat for any further versions until you’re done."}]}]}]},{"title":"Unit Testing full migration chain","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"The other option is migrating the whole chain and checking where you want to."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"anchor":"Unit-Testing-full-migration-chain","stepsSection":[{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"First, again create a ","type":"text"},{"code":"MigrationTester","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"VeinTesting","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"step","media":null,"code":"unit-test-migrations-f-0.swift","runtimePreview":null},{"caption":[],"type":"step","media":null,"content":[{"inlineContent":[{"type":"text","text":"Just like before, seed the database with arbitrary contents you want to migrate."}],"type":"paragraph"}],"code":"unit-test-migrations-f-1.swift","runtimePreview":null},{"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"For every version you want to check after migrating, add the version with a validation block to the validations dictionary.","type":"text"}]}],"code":"unit-test-migrations-f-2.swift","runtimePre