 important for data integrity.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To make unit tests slightly more pleasant, Vein comes with a testing helper.","type":"text"}]}]},{"tasks":[{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"This is a shortened part of one of Vein’s unit tests.","type":"text"}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"caption":[],"media":null,"code":"unit-test-migrations-schemas.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You would just use your own existing models and migrations."}]}],"runtimePreview":null,"type":"step"}],"anchor":"The-migration-we-are-going-to-test","title":"The migration we are going to test:"},{"contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"There are two builtin ways to test your migrations."},{"type":"text","text":" "},{"type":"text","text":"First we’re going to cover the step by step approach and then the full chain one."},{"type":"text","text":" "},{"type":"text","text":"You can choose whatever you like more."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"stepsSection":[{"code":"unit-test-migrations-0.swift","type":"step","media":null,"runtimePreview":null,"content":[{"inlineContent":[{"text":"First, create a ","type":"text"},{"type":"codeVoice","code":"MigrationTester"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"VeinTesting"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It will validate the protocol requirements of ","type":"text"},{"type":"codeVoice","code":"VersionedSchema"},{"text":".","type":"text"}],"type":"paragraph"}],"caption":[]},{"code":"unit-test-migrations-1.swift","type":"step","media":null,"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Now seed the database with arbitrary contents you want to migrate."},{"type":"text","text":" "},{"type":"text","text":"We recommend starting at the first version to cover everything."}],"type":"paragraph"}],"caption":[]},{"code":"unit-test-migrations-2.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now migrate to the next version and check the migration results."}]}],"caption":[]},{"code":"unit-test-migrations-3.swift","type":"step","media":null,"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeat for any further versions until you’re done."}]}],"caption":[]}],"anchor":"Unit-Testing","title":"Unit Testing"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The other option is migrating the whole chain and checking where you want to."}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, again create a "},{"code":"MigrationTester","type":"codeVoice"},{"type":"text","text":" from "},{"code":"VeinTesting","type":"codeVoice"},{"type":"text","text":"."}]}],"caption":[],"runtimePreview":null,"type":"step","media":null,"code":"unit-test-migrations-f-0.swift"},{"content":[{"inlineContent":[{"type":"text","text":"Just like before, seed the database with arbitrary contents you want to migrate."}],"type":"paragraph"}],"caption":[],"runtimePreview":null,"type":"step","media":null,"code":"unit-test-migrations-f-1.swift"},{"content":[{"inlineContent":[{"text":"For every version you want to check after migrating, add the version with a validation block to the validations dictionary.","type":"text"}],"type":"paragraph"}],"caption":[],"runtimePreview":null,"type":"step","media":null,"code":"unit-test-migrations-f-2.swift"}],"anchor":"Unit-Testing-full-migration-chain","title":"Unit Testing full migration chain"}],"kind":"tasks"}],"references":{"doc://VeinCore/tutorials/VeinCore/Relationships#Persisting--fetching-a-relationship":{"url":"\/tutorials\/veincore\/relationships#Persisting--fetching-a-relationship","title":"Persisting & fetching a relationship","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships#Persisting--fetching-a-relationship","role":"pseudoSymbol"},"doc://VeinCore/tutorials/VeinCore/Relationships":{"title":"Relationships","role":"project","kind":"project","abstract":[{"type":"text","text":"Use relationships with VeinCore."}],"url":"\/tutorials\/veincore\/relationships","estimatedTime":"3min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships","type":"topic"},"unit-test-migrations-f-1.swift":{"content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct FullChain {","    @Test","    func fullChainVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.testCompleteChain(","            initialData: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            },","            validations: [","                ","            ]","        )","    }","}"],"syntax":"swift","type":"file","highlights":[],"identifier":"unit-test-migrations-f-1.swift","fileName":"FullChainTest.swift","fileType":"swift"},"unit-test-migrations-schemas.swift":{"content":["import Foundation","import VeinCore","","fileprivate enum Version1: VersionedSchema {","    static let version = ModelVersion(1, 0, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        init(username: String) { self.username = username }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        init(bio: String) { self.bio = bio }","    }","}","","fileprivate enum Version2: VersionedSchema {","    static let version = ModelVersion(1, 1, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        \/\/ Added field","        @Field var email: String?","        init(username: String, email: String?) {","            self.username = username","            self.email = email","        }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        init(bio: String) { self.bio = bio }","    }","}","","fileprivate enum Version3: VersionedSchema {","    static let version = ModelVersion(1, 2, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self,","        Post.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        @Field var email: String?","        init(username: String, email: String?) {","            self.username = username","            self.email = email","        }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        \/\/ added field","        @Field var internalID: String","        init(bio: String, internalID: String) {","            self.bio = bio","            self.internalID = internalID","        }","    }","    ","    @Model","    final class Post {","        @Field var content: String","        init(content: String) { self.content = content }","    }","}","","fileprivate enum MigrationPlan: SchemaMigrationPlan {","    static var schemas: [any Vein.VersionedSchema.Type] {[","        Version1.self,","        Version2.self,","        Version3.self","    ]}","    ","    static var stages: [Vein.MigrationStage] {[","        v1ToV2,","        v2ToV3,","    ]}","    ","    static let v1ToV2 = Vein.MigrationStage.complex(","        fromVersion: Version1.self,","        toVersion: Version2.self,","        willMigrate: { context in","            try Version1.User.fieldsAddedMigration(to: Version2.User.self, on: context)","            try Version1.Profile.unchangedMigration(to: Version2.Profile.self, on: context)","        },","        didMigrate: nil","    )","    ","    static let v2ToV3 = Vein.MigrationStage.complex(","        fromVersion: Version2.self,","        toVersion: Version3.self,","        willMigrate: { context in","            \/\/ Basic migrations","            try Version2.User.unchangedMigration(to: Version3.User.self, on: context)","            ","            \/\/ Logic migration for Profile","            let oldProfiles = try context.fetchAll(Version2.Profile.self)","            for old in oldProfiles {","                let new = Version3.Profile(","                    bio: old.bio,","                    internalID: \"ID-\\(Int.random(in: 1000...9999))\"","                )","                try context.insert(new)","                try context.delete(old)","            }","        },","        didMigrate: nil","    )","}"],"syntax":"swift","type":"file","highlights":[],"identifier":"unit-test-migrations-schemas.swift","fileName":"Schemas.swift","fileType":"swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package":{"type":"topic","url":"\/tutorials\/veincore\/quick-start-swift-package","kind":"project","title":"Quick start Swift Package","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package","role":"project","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"estimatedTime":"5min"},"unit-test-migrations-f-2.swift":{"content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct FullChain {","    @Test","    func fullChainVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.testCompleteChain(","            initialData: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            },","            validations: [","                Version3.version: { context in","                    let users = try context","                        .fetchAll(Version3.User.self)","                    #expect(users.count == 1)","                    ","                    let profiles = try context","                        .fetchAll(Version3.Profile.self)","                    #expect(profiles.count == 1)","                    ","                    if let profile = profiles.first {","                        #expect(profile.bio == bio)","                        #expect(profile.internalID.hasPrefix(\"ID-\"))","                        if let id = Int(profile.internalID.dropFirst(3)) {","                            #expect((1000...9999).contains(id))","                        } else {","                            Issue.record(\"Internal ID should be a number after `ID-` prefix\")","                        }","                    }","                }","            ]","        )","    }","}"],"syntax":"swift","type":"file","highlights":[],"identifier":"unit-test-migrations-f-2.swift","fileName":"FullChainTest.swift","fileType":"swift"},"unit-test-migrations-1.swift":{"syntax":"swift","highlights":[],"fileName":"StepByStepTest.swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","    }","}"],"type":"file","fileType":"swift","identifier":"unit-test-migrations-1.swift"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations#Migrating-Schemas":{"kind":"section","url":"\/tutorials\/veincore\/simplemigrations#Migrating-Schemas","abstract":[{"type":"text","text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions."}],"role":"pseudoSymbol","title":"Migrating Schemas","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations#Migrating-Schemas","type":"section"},"unit-test-migrations-2.swift":{"syntax":"swift","identifier":"unit-test-migrations-2.swift","highlights":[],"type":"file","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version2.self,","            with: { context in","                let users = try context","                    .fetchAll(Version2.User.self)","                #expect(users.count == 1)","                ","                if let user = users.first {","                    #expect(user.username == username)","                    #expect(user.email == nil)","                    ","                    user.email = email","                }","                ","                let profiles = try context","                    .fetchAll(Version2.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                }","                ","                try context.save()","            }","        )","    }","}"],"fileType":"swift","fileName":"StepByStepTest.swift"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"role":"project","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"kind":"project","estimatedTime":"7min","title":"Complex Migrations","url":"\/tutorials\/veincore\/complexmigrations"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations#Writing-Custom-Migration-Logic":{"title":"Writing Custom Migration Logic","type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations#Writing-Custom-Migration-Logic","url":"\/tutorials\/veincore\/complexmigrations#Writing-Custom-Migration-Logic","abs