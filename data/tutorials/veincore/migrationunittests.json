e-going-to-test":{"url":"\/tutorials\/veincore\/migrationunittests#The-migration-we-are-going-to-test","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}],"title":"The migration we are going to test:","type":"section","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#The-migration-we-are-going-to-test","role":"pseudoSymbol"},"unit-test-migrations-0.swift":{"content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","    }","}"],"identifier":"unit-test-migrations-0.swift","highlights":[],"fileType":"swift","syntax":"swift","fileName":"StepByStepTest.swift","type":"file"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries#FetchDescriptor-and-PaginatedFetchDescriptor","kind":"section","role":"pseudoSymbol","type":"section","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"url":"\/tutorials\/veincore\/advancedqueries#FetchDescriptor-and-PaginatedFetchDescriptor","title":"FetchDescriptor and PaginatedFetchDescriptor"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing-full-migration-chain":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing-full-migration-chain","role":"pseudoSymbol","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing-full-migration-chain","title":"Unit Testing full migration chain","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"kind":"section","type":"section"},"doc://VeinCore/tutorials/Table-of-Contents/Simple-Migrations":{"abstract":[],"type":"topic","url":"\/tutorials\/table-of-contents\/simple-migrations","kind":"article","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Simple-Migrations","title":"Simple Migrations"},"unit-test-migrations-2.swift":{"fileType":"swift","fileName":"StepByStepTest.swift","type":"file","syntax":"swift","highlights":[],"identifier":"unit-test-migrations-2.swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version2.self,","            with: { context in","                let users = try context","                    .fetchAll(Version2.User.self)","                #expect(users.count == 1)","                ","                if let user = users.first {","                    #expect(user.username == username)","                    #expect(user.email == nil)","                    ","                    user.email = email","                }","                ","                let profiles = try context","                    .fetchAll(Version2.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                }","                ","                try context.save()","            }","        )","    }","}"]},"unit-test-migrations-f-0.swift":{"type":"file","fileName":"FullChainTest.swift","highlights":[],"syntax":"swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct FullChain {","    @Test","    func fullChainVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","    }","}"],"fileType":"swift","identifier":"unit-test-migrations-f-0.swift"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#RawRepresentable":{"abstract":[{"text":"Make your own types persistable.","type":"text"}],"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/veincore\/custompersistable#RawRepresentable","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#RawRepresentable","title":"RawRepresentable"},"doc://VeinCore/tutorials/Table-of-Contents/Custom-Persistable":{"abstract":[],"type":"topic","url":"\/tutorials\/table-of-contents\/custom-persistable","kind":"article","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Custom-Persistable","title":"Custom Persistable"},"unit-test-migrations-1.swift":{"highlights":[],"fileType":"swift","identifier":"unit-test-migrations-1.swift","fileName":"StepByStepTest.swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","    }","}"],"type":"file","syntax":"swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Create-your-first-Model":{"type":"section","role":"pseudoSymbol","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Create-your-first-Model","url":"\/tutorials\/veincore\/quick-start-xcode#Create-your-first-Model","title":"Create your first Model","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"kind":"section"},"doc://VeinCore/tutorials/VeinCore/AdvancedQueries":{"role":"project","title":"Advanced Queries","url":"\/tutorials\/veincore\/advancedqueries","kind":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/AdvancedQueries","abstract":[{"text":"Sometimes filtering is not enough. Starting Vein 1.1 you can sort and paginate queries.","type":"text"}],"estimatedTime":"5min","type":"topic"},"doc://VeinCore/tutorials/Table-of-Contents/Relationships":{"title":"Relationships","type":"topic","kind":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Relationships","url":"\/tutorials\/table-of-contents\/relationships","abstract":[],"role":"article"},"unit-test-migrations-schemas.swift":{"fileName":"Schemas.swift","type":"file","highlights":[],"fileType":"swift","identifier":"unit-test-migrations-schemas.swift","syntax":"swift","content":["import Foundation","import VeinCore","","fileprivate enum Version1: VersionedSchema {","    static let version = ModelVersion(1, 0, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        init(username: String) { self.username = username }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        init(bio: String) { self.bio = bio }","    }","}","","fileprivate enum Version2: VersionedSchema {","    static let version = ModelVersion(1, 1, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        \/\/ Added field","        @Field var email: String?","        init(username: String, email: String?) {","            self.username = username","            self.email = email","        }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        init(bio: String) { self.bio = bio }","    }","}","","fileprivate enum Version3: VersionedSchema {","    static let version = ModelVersion(1, 2, 0)","    static var models: [any Vein.PersistentModel.Type] {[","        User.self,","        Profile.self,","        Post.self","    ]}","    ","    @Model","    final class User {","        @Field var username: String","        @Field var email: String?","        init(username: String, email: String?) {","            self.username = username","            self.email = email","        }","    }","    ","    @Model","    final class Profile {","        @Field var bio: String","        \/\/ added field","        @Field var internalID: String","        init(bio: String, internalID: String) {","            self.bio = bio","            self.internalID = internalID","        }","    }","    ","    @Model","    final class Post {","        @Field var content: String","        init(content: String) { self.content = content }","    }","}","","fileprivate enum MigrationPlan: SchemaMigrationPlan {","    static var schemas: [any Vein.VersionedSchema.Type] {[","        Version1.self,","        Version2.self,","        Version3.self","    ]}","    ","    static var stages: [Vein.MigrationStage] {[","        v1ToV2,","        v2ToV3,","    ]}","    ","    static let v1ToV2 = Vein.MigrationStage.complex(","        fromVersion: Version1.self,","        toVersion: Version2.self,","        willMigrate: { context in","            try Version1.User.fieldsAddedMigration(to: Version2.User.self, on: context)","            try Version1.Profile.unchangedMigration(to: Version2.Profile.self, on: context)","        },","        didMigrate: nil","    )","    ","    static let v2ToV3 = Vein.MigrationStage.complex(","        fromVersion: Version2.self,","        toVersion: Version3.self,","        willMigrate: { context in","            \/\/ Basic migrations","            try Version2.User.unchangedMigration(to: Version3.User.self, on: context)","            ","            \/\/ Logic migration for Profile","            let oldProfiles = try context.fetchAll(Version2.Profile.self)","            for old in oldProfiles {","                let new = Version3.Profile(","                    bio: old.bio,","                    internalID: \"ID-\\(Int.random(in: 1000...9999))\"","                )","                try context.insert(new)","                try context.delete(old)","            }","        },","        didMigrate: nil","    )","}"]},"doc://VeinCore/tutorials/Table-of-Contents/Unit-Testing-Migrations":{"title":"Unit Testing Migrations","type":"topic","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Unit-Testing-Migrations","kind":"article","role":"article","url":"\/tutorials\/table-of-contents\/unit-testing-migrations","abstract":[]},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests#Unit-Testing":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests#Unit-Testing","role":"pseudoSymbol","type":"section","abstract":[{"type":"text","text":"Migrations are a crucial and complex operation."},{"type":"text","text":" "},{"type":"text","text":"Please please please unit test your migrations, it’s incredibly important for data integrity."}],"title":"Unit Testing","url":"\/tutorials\/veincore\/migrationunittests#Unit-Testing","kind":"section"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#Setup":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#Setup","title":"Setup","url":"\/tutorials\/veincore\/quick-start-xcode#Setup","role":"pseudoSymbol","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"type":"section","kind":"section"},"doc://VeinCore/tutorials/VeinCore/MigrationUnitTests":{"type":"topic","url":"\/tutorials\/veincore\/migrationunittests","kind":"project","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/MigrationUnitTests","title":"Unit Testing Migrations","role":"project","estimatedTime":"10min","abstract":[{"text":"Migrations are a crucial and complex operation.","type":"text"},{"text":" ","type":"text"},{"text":"Please please please unit test your migrations, it’s incredibly important for data integrity.","type":"text"}]},"doc://VeinCore/tutorials/Table-of-Contents/Advanced-Queries":{"identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Advanced-Queries","url":"\/tutorials\/table-of-contents\/advanced-queries","role":"article","type":"topic","abstract":[],"kind":"article","title":"Advanced Queries"},"doc://VeinCore/tutorials/VeinCore/SimpleMigrations":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/SimpleMigrations","kind":"project","type":"topic","role":"project","url":"\/tutorials\/veincore\/simplemigrations","abstract":[{"type":"text","text":"Effortlessly & safely evolve your database schema using stage-by-stage migrations & Vein helper functions."}],"estimatedTime":"5min","title":"Simple Database Migrations"},"unit-test-migrations-f-2.swift":{"fileType":"swift","highlights":[],"content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct FullChain {","    @Test","    func fullChainVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.testCompleteChain(","            initialData: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            },","            validations: [","                Version3.version: { context in","                    let users = try context","                        .fetchAll(Version3.User.self)","                    #expect(users.count == 1)","                    ","                    let profiles = try context","                        .fetchAll(Version3.Profile.self)","                    #expect(profiles.count == 1)","                    ","                    if let profile = profiles.first {","                        #expect(profile.bio == bio)","                        #expect(profile.internalID.hasPrefix(\"ID-\"))","                        if let id = Int(profile.internalID.dropFirst(3)) {","                            #expect((1000...9999).contains(id))","                        } else {","                            Issue.record(\"Internal ID should be a number after `ID-` prefix\")","                        }","                    }","                }","            ]","        )","    }","}"],"fileName":"FullChainTest.swift","type":"file","syntax":"swift","identifier":"unit-test-migrations-f-2.swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package","type":"topic","url":"\/tutorials\/veincore\/quick-start-swift-package","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"role":"project","estimatedTime":"5min","kind":"project","title":"Quick start Swift Package"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Setup":{"type":"section","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-swift-package#Setup","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"kind":"section","title":"Setup","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Setup"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode#ModelContainer--ManagedObjectContext":{"type":"section","role":"pseudoSymbol","url":"\/tutorials\/veincore\/quick-start-xcode#ModelContainer--ManagedObjectContext","abstract":[{"text":"Install VeinCore and create your first model.","type":"text"}],"kind":"section","title":"ModelContainer & ManagedObjectContext","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode#ModelContainer--ManagedObjectContext"},"doc://VeinCore/tutorials/VeinCore/ComplexMigrations":{"title":"Complex Migrations","type":"topic","url":"\/tutorials\/veincore\/complexmigrations","role":"project","abstract":[{"text":"Handle structural database transformations by fetching existing models and inserting new ones.","type":"text"}],"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/ComplexMigrations","kind":"project","estimatedTime":"7min"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Xcode":{"kind":"project","role":"project","type":"topic","url":"\/tutorials\/veincore\/quick-start-xcode","title":"Quick start Xcode","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}],"estimatedTime":"5min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Xcode"},"doc://VeinCore/tutorials/VeinCore/Relationships":{"role":"project","url":"\/tutorials\/veincore\/relationships","abstract":[{"text":"Use relationships with VeinCore.","type":"text"}],"title":"Relationships","kind":"project","type":"topic","estimatedTime":"3min","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Relationships"},"doc://VeinCore/tutorials/Table-of-Contents/Quick-start":{"url":"\/tutorials\/table-of-contents\/quick-start","role":"article","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Quick-start","title":"Quick start","kind":"article","type":"topic","abstract":[]},"doc://VeinCore/tutorials/Table-of-Contents/Complex-Migrations":{"role":"article","type":"topic","title":"Complex Migrations","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents\/Complex-Migrations","abstract":[],"url":"\/tutorials\/table-of-contents\/complex-migrations","kind":"article"},"unit-test-migrations-3.swift":{"type":"file","highlights":[],"fileType":"swift","content":["import Foundation","import Testing","import VeinCore","import VeinTesting","","@MainActor","struct StepByStep {","    @Test","    func stepByStepVerification() async throws {","        let tester = try MigrationTester(migrationPlan: MigrationPlan.self)","        ","        let username = \"miakoring\"","        let bio = \"Amethyst Vein\"","        let email = \"example@amethystsoft.de\"","        ","        try tester.seed(","            version: Version1.self,","            with: { context in","                let user = Version1.User(username: username)","                let profile = Version1.Profile(bio: bio)","                ","                try context.insert(user)","                try context.insert(profile)","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version2.self,","            with: { context in","                let users = try context","                    .fetchAll(Version2.User.self)","                #expect(users.count == 1)","                ","                if let user = users.first {","                    #expect(user.username == username)","                    #expect(user.email == nil)","                    ","                    user.email = email","                }","                ","                let profiles = try context","                    .fetchAll(Version2.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                }","                ","                try context.save()","            }","        )","        ","        try tester.migrateAndCheck(","            version: Version3.self,","            with: { context in","                let users = try context","                    .fetchAll(Version3.User.self)","                #expect(users.count == 1)","                ","                let profiles = try context","                    .fetchAll(Version3.Profile.self)","                #expect(profiles.count == 1)","                ","                if let profile = profiles.first {","                    #expect(profile.bio == bio)","                    #expect(profile.internalID.hasPrefix(\"ID-\"))","                    if let id = Int(profile.internalID.dropFirst(3)) {","                        #expect((1000...9999).contains(id))","                    } else {","                        Issue.record(\"Internal ID should be a number after `ID-` prefix\")","                    }","                }","            }","        )","    }","}"],"identifier":"unit-test-migrations-3.swift","syntax":"swift","fileName":"StepByStepTest.swift"},"doc://VeinCore/tutorials/VeinCore/Quick-start-Swift-Package#Create-your-first-Model":{"type":"section","url":"\/tutorials\/veincore\/quick-start-swift-package#Create-your-first-Model","kind":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/Quick-start-Swift-Package#Create-your-first-Model","title":"Create your first Model","role":"pseudoSymbol","abstract":[{"type":"text","text":"Install VeinCore and create your first model."}]},"doc://VeinCore/tutorials/VeinCore/CustomPersistable":{"identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable","abstract":[{"type":"text","text":"Make your own types persistable."}],"type":"topic","url":"\/tutorials\/veincore\/custompersistable","estimatedTime":"5min","kind":"project","role":"project","title":"Custom Persistable"},"doc://VeinCore/tutorials/VeinCore/CustomPersistable#Manual-Persistable":{"role":"pseudoSymbol","url":"\/tutorials\/veincore\/custompersistable#Manual-Persistable","abstract":[{"type":"text","text":"Make your own types persistable."}],"title":"Manual Persistable","kind":"section","type":"section","identifier":"doc:\/\/VeinCore\/tutorials\/VeinCore\/CustomPersistable#Manual-Persistable"},"doc://VeinCore/tutorials/Table-of-Contents":{"kind":"overview","title":"Meet Vein","identifier":"doc:\/\/VeinCore\/tutorials\/Table-of-Contents","type":"topic","url":"\/tutorials\/table-of-contents","abstract":[{"text":"Database for apps made easy.","type":"text"}],"role":"overview"}}}